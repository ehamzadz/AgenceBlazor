                    <!-- Room Type Distribution with Individual Prices -->
                    <div class="bkg-field">
                        <label class="bkg-label">توزيع المعتمرين والأسعار حسب نوع الغرفة</label>
                        <div class="bkg-room-dist">
                            <!-- جماعي -->
                            <div class="bkg-room-row">
                                <span class="bkg-room-type">جماعي</span>
                                <input type="number" class="bkg-input bkg-sm-input" @bind="roomCounts.Group" min="0" placeholder="0" />
                                <span>معتمر ×</span>
                                <input type="number" class="bkg-input bkg-price-input" @bind="roomPrices.GroupPrice" step="1000" min="0" placeholder="السعر" />
                                <span>دج</span>
                            </div>
                            <!-- رباعي -->
                            <div class="bkg-room-row">
                                <span class="bkg-room-type">رباعي</span>
                                <input type="number" class="bkg-input bkg-sm-input" @bind="roomCounts.Quadruple" min="0" placeholder="0" />
                                <span>معتمر ×</span>
                                <input type="number" class="bkg-input bkg-price-input" @bind="roomPrices.QuadruplePrice" step="1000" min="0" placeholder="السعر" />
                                <span>دج</span>
                            </div>
                            <!-- ثلاثي -->
                            <div class="bkg-room-row">
                                <span class="bkg-room-type">ثلاثي</span>
                                <input type="number" class="bkg-input bkg-sm-input" @bind="roomCounts.Triple" min="0" placeholder="0" />
                                <span>معتمر ×</span>
                                <input type="number" class="bkg-input bkg-price-input" @bind="roomPrices.TriplePrice" step="1000" min="0" placeholder="السعر" />
                                <span>دج</span>
                            </div>
                            <!-- ثنائي -->
                            <div class="bkg-room-row">
                                <span class="bkg-room-type">ثنائي</span>
                                <input type="number" class="bkg-input bkg-sm-input" @bind="roomCounts.Double" min="0" placeholder="0" />
                                <span>معتمر ×</span>
                                <input type="number" class="bkg-input bkg-price-input" @bind="roomPrices.DoublePrice" step="1000" min="0" placeholder="السعر" />
                                <span>دج</span>
                            </div>
                            <!-- طفل -->
                            <div class="bkg-room-row">
                                <span class="bkg-room-type">طفل</span>
                                <input type="number" class="bkg-input bkg-sm-input" @bind="roomCounts.Child" min="0" placeholder="0" />
                                <span>معتمر ×</span>
                                <input type="number" class="bkg-input bkg-price-input" @bind="roomPrices.ChildPrice" step="1000" min="0" placeholder="السعر" />
                                <span>دج</span>
                            </div>
                            <!-- رضيع -->
                            <div class="bkg-room-row">
                                <span class="bkg-room-type">رضيع</span>
                                <input type="number" class="bkg-input bkg-sm-input" @bind="roomCounts.Infant" min="0" placeholder="0" />
                                <span>معتمر ×</span>
                                <input type="number" class="bkg-input bkg-price-input" @bind="roomPrices.InfantPrice" step="1000" min="0" placeholder="السعر" />
                                <span>دج</span>
                            </div>
                        </div>
                        <div class="bkg-total-pilgrims">
                            <span>إجمالي المعتمرين:</span>
                            <strong>@totalAgencyPilgrims</strong>
                        </div>
                    </div>
                </div>

                <!-- Right Column -->
                <div class="bkg-col">
                    <!-- Agency Selection -->
                    <div class="bkg-field">
                        <label class="bkg-label">الوكالة</label>
                        <select class="bkg-select" @bind="selectedAgency">
                            <option value="">اختر الوكالة...</option>
                            @foreach (var agency in agencyNames)
                            {
                                <option value="@agency">@agency</option>
                            }
                        </select>
                    </div>
                    <!-- Commission per adult -->
                    <div class="bkg-field bkg-currency">
                        <label class="bkg-label">عمولة الوكالة لكل معتمر (دج)</label>
                        <input type="number" class="bkg-input" @bind="agencyCommission" step="500" min="0" />
                        <span class="bkg-currency-sym">دج</span>
                    </div>

                    <!-- Custom Reduction -->
                    <div class="bkg-field bkg-currency">
                        <label class="bkg-label">تخفيض / خصم (دج)</label>
                        <input type="number" class="bkg-input" @bind="customReduction" step="500" min="0" />
                        <span class="bkg-currency-sym">دج</span>
                    </div>

                    <!-- Calculations -->
                    @{
                        // Calculate total based on each room type count × its price
                        var groupTotal = roomCounts.Group * roomPrices.GroupPrice;
                        var quadTotal = roomCounts.Quadruple * roomPrices.QuadruplePrice;
                        var tripleTotal = roomCounts.Triple * roomPrices.TriplePrice;
                        var doubleTotal = roomCounts.Double * roomPrices.DoublePrice;
                        var ChildTotal = roomCounts.Child * roomPrices.ChildPrice;
                        var InfantTotal = roomCounts.Infant * roomPrices.InfantPrice;
                        var subTotal = groupTotal + quadTotal + tripleTotal + doubleTotal + ChildTotal + InfantTotal;

                        // Apply reduction
                        var agencyTotalAmount = subTotal - customReduction;
                        if (agencyTotalAmount < 0) agencyTotalAmount = 0;

                        // Adult pilgrims (without child and infant)
                        var adultPilgrims = roomCounts.Group + roomCounts.Quadruple + roomCounts.Triple + roomCounts.Double;

                        // Commission = عمولة الوكالة × عدد المعتمرين البالغين (بدون أطفال ورضع)
                        var totalCommission = agencyCommission * adultPilgrims;

                        // Net profit
                        var agencyNetProfit = agencyTotalAmount - totalCommission;
                    }

                    <!-- Room Price Summary -->
                    <div class="bkg-price-summary">
                        <label class="bkg-label">ملخص الأسعار</label>
                        @if (roomCounts.Group > 0)
                        {
                            <div class="bkg-price-row"><span>جماعي (@roomCounts.Group × @roomPrices.GroupPrice.ToString("N0")):</span><span>@groupTotal.ToString("N0") دج</span></div>
                        }
                        @if (roomCounts.Quadruple > 0)
                        {
                            <div class="bkg-price-row"><span>رباعي (@roomCounts.Quadruple × @roomPrices.QuadruplePrice.ToString("N0")):</span><span>@quadTotal.ToString("N0") دج</span></div>
                        }
                        @if (roomCounts.Triple > 0)
                        {
                            <div class="bkg-price-row"><span>ثلاثي (@roomCounts.Triple × @roomPrices.TriplePrice.ToString("N0")):</span><span>@tripleTotal.ToString("N0") دج</span></div>
                        }
                        @if (roomCounts.Double > 0)
                        {
                            <div class="bkg-price-row"><span>ثنائي (@roomCounts.Double × @roomPrices.DoublePrice.ToString("N0")):</span><span>@doubleTotal.ToString("N0") دج</span></div>
                        }
                        @if (roomCounts.Child > 0)
                        {
                            <div class="bkg-price-row"><span>طفل (@roomCounts.Child × @roomPrices.ChildPrice.ToString("N0")):</span><span>@ChildTotal.ToString("N0") دج</span></div>
                        }
                        @if (roomCounts.Infant > 0)
                        {
                            <div class="bkg-price-row"><span>رضيع (@roomCounts.Infant × @roomPrices.InfantPrice.ToString("N0")):</span><span>@InfantTotal.ToString("N0") دج</span></div>
                        }
                        <div class="bkg-price-row" style="border-top:1px solid #e5e7eb; padding-top:0.3rem; margin-top:0.3rem;">
                            <span>المجموع الفرعي:</span><span style="font-weight:700;">@subTotal.ToString("N0") دج</span>
                        </div>
                        @if (customReduction > 0)
                        {
                            <div class="bkg-price-row" style="color:#dc2626;">
                                <span>تخفيض:</span><span>- @customReduction.ToString("N0") دج</span>
                            </div>
                        }
                    </div>

                    <!-- Commission Summary -->
                    <div class="bkg-price-summary" style="margin-top:0.5rem; background:#fefce8; border-color:#fde68a;">
                        <label class="bkg-label">العمولة</label>
                        <div class="bkg-price-row">
                            <span>البالغين (بدون أطفال ورضع):</span><span>@adultPilgrims معتمر</span>
                        </div>
                        <div class="bkg-price-row" style="font-weight:700;">
                            <span>العمولة (@adultPilgrims × @agencyCommission.ToString("N0")):</span><span style="color:#dc2626;">@totalCommission.ToString("N0") دج</span>
                        </div>
                    </div>

                    <!-- Total Amount -->
                    <div class="bkg-total">
                        <span>المبلغ الإجمالي</span>
                        <span class="bkg-total-val">@agencyTotalAmount.ToString("N0") دج</span>
                    </div>

                    <!-- Net Profit -->
                    <div class="bkg-profit">
                        <span class="bkg-profit-lbl">الربح الصافي</span>
                        <span class="bkg-profit-val">@agencyNetProfit.ToString("N0") دج</span>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="bkg-footer">
                <button class="bkg-btn-cancel" @onclick="CancelAgencyBooking" disabled="@isAgencyBookingSaving">
                    ✕ إلغاء
                </button>
                <button class="bkg-btn-save" @onclick="SaveAgencyBooking" disabled="@isAgencyBookingSaving">
                    @if (isAgencyBookingSaving)
                    {
                        <span class="bkg-spinner"></span>
                        <span>جاري الحفظ...</span>
                    }
                    else
                    {
                        <span>🖨️ طباعة وحفظ</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

