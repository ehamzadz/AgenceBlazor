@page "/TripsGallery"
@rendermode InteractiveServer
@using System.Globalization
@using AgenceBlazor.Models
@using AgenceBlazor.Services
@inject TripService TripService
@inject HotelService HotelService
@inject AgencyService AgencyService
@inject AgencyBookingService AgencyBookingService
@inject DirectPilgrimService DirectPilgrimService
@* @inject TripGuideService TripGuideService *@
@inject ITripGuideService TripGuideService
@inject IJSRuntime JSRuntime

<div class="trips-cards-container">
    <div class="cards-header">
        <div class="header-top">
            <div class="header-content">
                <div class="header-badge">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 2L2 7l10 5 10-5-10-5z" />
                        <path d="M2 17l10 5 10-5" />
                        <path d="M2 12l10 5 10-5" />
                    </svg>
                    <span>رحلات العمرة</span>
                </div>
                <h1 class="cards-title">الرحلات المتاحة</h1>
                <p class="cards-subtitle">استعرض رحلاتنا المتاحة واختر ما يناسبك</p>
            </div>
            <div class="header-stats">
                <div class="stat-item">
                    <span class="stat-value">@totalTrips</span>
                    <span class="stat-label">إجمالي الرحلات</span>
                </div>
                <div class="stat-item">
                    <span class="stat-value">@directTrips</span>
                    <span class="stat-label">مباشرة</span>
                </div>
                <div class="stat-item">
                    <span class="stat-value">@indirectTrips</span>
                    <span class="stat-label">غير مباشرة</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Search Section -->
    <div class="search-section">
        <div class="search-container">
            <div class="search-wrapper">
                <div class="search-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8" />
                        <path d="M21 21l-4.35-4.35" />
                    </svg>
                </div>
                <button class="search-clear" @onclick="ClearSearch" style="@(string.IsNullOrEmpty(searchQuery) ? "display: none;" : "")">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18" />
                        <line x1="6" y1="6" x2="18" y2="18" />
                    </svg>
                </button>
                <input type="text"
                       class="search-input"
                       placeholder="ابحث عن رحلة... (رقم الرحلة، الاسم، المحطة، أو البرنامج)"
                       @bind="searchQuery"
                       @bind:event="oninput"
                       @onkeydown="HandleKeyDown" />

                <button class="search-clear" @onclick="ClearSearch" style="@(string.IsNullOrEmpty(searchQuery) ? "display: none;" : "")">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18" />
                        <line x1="6" y1="6" x2="18" y2="18" />
                    </svg>
                </button>
                <button class="search-btn" @onclick="HandleSearch">
                    <span>بحث</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8" />
                        <path d="M21 21l-4.35-4.35" />
                    </svg>
                </button>
            </div>
            <div class="search-tags">
                @{
                    var searchTags = new List<(string Query, string Label)>
                    {
                        ("مباشرة", "رحلات مباشرة"),
                        ("غير مباشرة", "رحلات غير مباشرة"),
                        ("السعودية", "الخطوط السعودية"),
                        ("التركية", "الخطوط التركية"),
                        ("المدينة المنورة", "دخول مدينة"),
                        ("جدة", "دخول جدة"),
                        ("الجزائر", "الجزائر"),
                        ("قسنطينة", "قسنطينة")
                    };
                }

                @foreach (var tag in searchTags)
                {
                    <span class="search-tag" @onclick="@(() => SetSearchQuery(tag.Query))">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <polyline points="20 6 9 17 4 12" />
                        </svg>
                        @tag.Label
                    </span>
                }
            </div>
            @if (filteredTrips != null && allTrips != null && filteredTrips.Count < allTrips.Count)
            {
                <div class="search-results-count">
                    <span>@filteredTrips.Count</span>
                    <span>نتيجة</span>
                </div>
            }
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading-container">
            <div class="loading-spinner"></div>
            <p>جاري تحميل الرحلات...</p>
        </div>
    }
    else if (filteredTrips != null && filteredTrips.Any())
    {
        <div class="trips-list">
            @foreach (var trip in filteredTrips)
            {
                var guideInfo = tripGuides.ContainsKey(trip.Id) ? tripGuides[trip.Id] : null;
                <div class="trip-card">
                    <div class="card-accent"></div>
                    <div class="card-body">
                        <div class="card-section details-section">
                            <div class="trip-main-info">
                                <div class="trip-header">
                                    <span class="trip-number">@trip.TripNumber</span>
                                    <h3 class="trip-name">@trip.TripName</h3>
                                </div>
                                <span class="trip-type-badge @(trip.TripType == "مباشرة" ? "direct" : "indirect")">
                                    <span class="badge-dot"></span>
                                    @trip.TripType
                                </span>
                            </div>
                            
                            <!-- Guide Info Badge -->
                            @if (guideInfo != null)
                            {
                                <div class="guide-info-badge">
                                    <div class="guide-badge">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                                            <circle cx="12" cy="7" r="4" />
                                        </svg>
                                        <span class="guide-name">@guideInfo.Name</span>
                                        <span class="guide-agency">@guideInfo.Agency</span>
                                        <span class="guide-grant">💰 @guideInfo.GrantAmount.ToString("N0") دج</span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="guide-info-badge empty">
                                    <span class="guide-empty-text">⚠️ لم يتم تعيين مرشد</span>
                                </div>
                            }

                            <div class="detail-divider"></div>
                            <div class="detail-block">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                    <line x1="16" y1="2" x2="16" y2="6"></line>
                                    <line x1="8" y1="2" x2="8" y2="6"></line>
                                    <line x1="3" y1="10" x2="21" y2="10"></line>
                                </svg>
                                <span class="detail-text">@trip.DepartureDate.ToString("dd MMMM yyyy", new CultureInfo("ar-SA"))</span>
                            </div>
                            <div class="detail-divider"></div>
                            <div class="detail-block">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
                                </svg>
                                <span class="detail-text">@trip.Airline</span>
                            </div>
                            <div class="detail-divider"></div>
                            <div class="detail-block">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="10" r="3"></circle>
                                    <path d="M12 21.7C17.3 17 20 13 20 10a8 8 0 1 0-16 0c0 3 2.7 6.9 8 11.7z"></path>
                                </svg>
                                <span class="detail-text">@trip.Program</span>
                            </div>

                            <div class="detail-divider"></div>
                            <div class="route-display">
                                <div class="route-point">
                                    <span class="point-time">الإقلاع</span>
                                    <span class="point-city">@trip.DepartureFrom</span>
                                </div>
                                <div class="route-visual">
                                    <span class="route-dot start"></span>
                                    <span class="route-line"></span>
                                    <span class="route-dot end"></span>
                                </div>
                                <div class="route-point">
                                    <span class="point-time">الوصول</span>
                                    <span class="point-city">@trip.ArrivalTo</span>
                                </div>
                            </div>
                        </div>

                        <div class="card-section action-section">
                            <div class="seats-display">
                                <div class="seats-bar-container">
                                    <div class="seats-bar">
                                        <div class="seats-bar-fill @(trip.RemainingSeats <= 5 ? "critical" : trip.RemainingSeats < 20 ? "urgent" : "")"
                                             style="width: @((trip.TotalSeats > 0 ? (trip.FilledSeats * 100) / trip.TotalSeats : 0))%">
                                        </div>
                                    </div>
                                    <div class="seats-labels">
                                        <div class="seat-label-item">
                                            <span class="label-text">الإجمالي</span>
                                            <span class="label-number">@trip.TotalSeats</span>
                                        </div>
                                        <div class="seat-label-item">
                                            <span class="label-text">محجوز</span>
                                            <span class="label-number">@trip.FilledSeats</span>
                                        </div>
                                        <div class="seat-label-item available">
                                            <span class="label-text">متاح</span>
                                            <span class="label-number @(trip.RemainingSeats < 20 ? "urgent" : "")">@trip.RemainingSeats</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="action-buttons">

                                <!-- Guide Button -->
                                <!-- Guide Button -->
                                <button class="action-btn guide-btn @(tripGuides.ContainsKey(trip.Id) ? "has-guide" : "")"
                                        title="@(tripGuides.ContainsKey(trip.Id) ? "تعديل المرشد" : "إدارة المرشد")"
                                        @onclick="async () => await OpenGuideModal(trip)">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                                        <circle cx="12" cy="7" r="4" />
                                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                                    </svg>
                                </button>
                                <!-- Show Hotels -->
                                <button class="action-btn" title="عرض الفنادق والأسعار" @onclick="() => OpenHotelsModal(trip)">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M19 21V5a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v16"></path>
                                        <path d="M3 21h18"></path>
                                        <line x1="8" y1="9" x2="16" y2="9"></line>
                                        <line x1="8" y1="13" x2="14" y2="13"></line>
                                        <line x1="8" y1="17" x2="16" y2="17"></line>
                                    </svg>
                                </button>

                                <!-- Add Hotel -->
                                <button class="action-btn" title="إضافة فندق" @onclick="() => OpenHotelModal(trip)">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M3 21h18"></path>
                                        <path d="M3 7v14h18V7l-9-5-9 5z"></path>
                                        <path d="M9 21v-8h6v8"></path>
                                    </svg>
                                </button>

                                <!-- Add Agency Booking -->
                                <button class="action-btn" title="إضافة حجز وكالة" @onclick="() => OpenAgencyBookingModal(trip)">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M12 5v14M5 12h14" />
                                        <rect x="3" y="3" width="18" height="18" rx="2" />
                                    </svg>
                                </button>

                                <!-- Add Travelers -->
                                @* <button class="action-btn" title="إضافة مسافرين" @onclick="() => AddAgencyBooking(trip.Id)">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                                        <circle cx="9" cy="7" r="4" />
                                        <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                                    </svg>
                                </button> *@
                                <!-- Direct Pilgrim Booking -->
                                <button class="action-btn" title="تسجيل معتمر مباشر" @onclick="() => OpenDirectBookingModal(trip)">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                                        <circle cx="9" cy="7" r="4" />
                                        <line x1="19" y1="8" x2="19" y2="14" />
                                        <line x1="22" y1="11" x2="16" y2="11" />
                                    </svg>
                                </button>

                                <!-- Edit -->
                                <button class="action-btn" title="تعديل" @onclick="() => OpenEditModal(trip)">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                                    </svg>
                                </button>

                                <!-- Delete -->
                                <button class="action-btn" title="حذف" @onclick="() => ConfirmDelete(trip)">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M3 6h18" />
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                                        <line x1="10" y1="11" x2="10" y2="17" />
                                        <line x1="14" y1="11" x2="14" y2="17" />
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (!isLoading)
    {
        <div class="no-results">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="11" cy="11" r="8" />
                <path d="M21 21l-4.35-4.35" />
            </svg>
            <h3>لا توجد رحلات</h3>
            <p>لم يتم العثور على رحلات تطابق معايير البحث</p>
        </div>
    }
</div>


<!-- Guide Modal -->
@if (showGuideModal && guideTrip != null)
{
    <div class="bkg-overlay" @onclick="CancelGuide">
        <div class="bkg-card" @onclick:stopPropagation="true">
            <div class="bkg-header" style="background: linear-gradient(135deg, #1e40af, #3b82f6);">
                <h3 class="bkg-title">🧭 إدارة مرشد الرحلة</h3>
                <button class="bkg-close" @onclick="CancelGuide" disabled="@isSavingGuide">✕</button>
            </div>

            <div class="bkg-body">
                <!-- Trip Summary -->
                <div class="bkg-summary">
                    <div class="bkg-summary-row">
                        <span class="bkg-summary-lbl">رقم الرحلة:</span>
                        <span class="bkg-summary-val">@guideTrip.TripNumber</span>
                    </div>
                    <div class="bkg-summary-row">
                        <span class="bkg-summary-lbl">الرحلة:</span>
                        <span class="bkg-summary-val">@guideTrip.TripName</span>
                    </div>
                    <div class="bkg-summary-row">
                        <span class="bkg-summary-lbl">التاريخ:</span>
                        <span class="bkg-summary-val">@guideTrip.DepartureDate.ToString("dd/MM/yyyy")</span>
                    </div>
                    <div class="bkg-route">✈ @guideTrip.DepartureFrom → @guideTrip.ArrivalTo</div>
                </div>

                <!-- Guide Form -->
                <div class="bkg-field">
                    <label class="bkg-label">اسم المرشد *</label>
                    <input type="text" class="bkg-input" @bind="guideName" @bind:event="oninput" placeholder="أدخل اسم المرشد" />
                </div>

                <div class="bkg-field">
                    <label class="bkg-label">الوكالة التابع لها</label>
                    <select class="bkg-select" @bind="guideAgency">
                        <option value="">اختر الوكالة...</option>
                        @foreach (var agency in agencyNames)
                        {
                            <option value="@agency">@agency</option>
                        }
                    </select>
                </div>

                <div class="bkg-field bkg-currency">
                    <label class="bkg-label">مبلغ المنحة (دج)</label>
                    <input type="number" class="bkg-input" @bind="guideGrantAmount" step="1000" min="0" />
                    <span class="bkg-currency-sym">دج</span>
                </div>

                @if (!string.IsNullOrEmpty(guideError))
                {
                    <div class="guide-error">❌ @guideError</div>
                }

                @if (existingGuide != null)
                {
                    <div class="guide-existing-info">
                        <div class="guide-existing-header">📋 المرشد الحالي</div>
                        <div class="guide-existing-row">
                            <span>الاسم:</span>
                            <strong>@existingGuide.Name</strong>
                        </div>
                        <div class="guide-existing-row">
                            <span>الوكالة:</span>
                            <strong>@existingGuide.Agency</strong>
                        </div>
                        <div class="guide-existing-row">
                            <span>المنحة:</span>
                            <strong>@existingGuide.GrantAmount.ToString("N0") دج</strong>
                        </div>
                    </div>
                }
            </div>

            <div class="bkg-footer">
                @if (existingGuide != null)
                {
                    <button class="bkg-btn-cancel" @onclick="DeleteGuide" disabled="@isSavingGuide" style="background:#dc2626;color:white;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M3 6h18" />
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                        </svg>
                        <span>حذف المرشد</span>
                    </button>
                }
                <button class="bkg-btn-cancel" @onclick="CancelGuide" disabled="@isSavingGuide">
                    ✕ إلغاء
                </button>

                <button class="bkg-btn-save" @onclick="SaveGuide" disabled="@isSavingGuide">
                    @if (isSavingGuide)
                    {
                        <span class="bkg-spinner"></span>
                        <span>جاري الحفظ...</span>
                    }
                    else
                    {
                        <span>💾 حفظ</span>
                    }
                </button>
                @* <button class="bkg-btn-save"
                        @onclick="@(async () => { Console.WriteLine($"CLICK guideName=[{guideName}]"); await SaveGuide(); })"
                        disabled="@isSavingGuide">
                    @if (isSavingGuide)
                    {
                        <span class="bkg-spinner"></span>
                        <span>جاري الحفظ...</span>
                    }
                    else
                    {
                        <span>💾 حفظ</span>
                    }
                </button> *@
            </div>
        </div>
    </div>
}


<!-- Delete Confirmation Modal -->
@if (showDeleteModal)
{
    <div class="modal-overlay" @onclick="CancelDelete">
        <div class="modal-container" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div class="modal-icon danger">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                        <line x1="12" y1="9" x2="12" y2="13" />
                        <line x1="12" y1="17" x2="12.01" y2="17" />
                    </svg>
                </div>
                <h3>تأكيد الحذف</h3>
            </div>

            <div class="modal-body">
                <p>هل أنت متأكد من حذف هذه الرحلة؟</p>
                @if (tripToDelete != null)
                {
                    <div class="delete-trip-info">
                        <div class="info-row">
                            <span class="info-label">رقم الرحلة:</span>
                            <span class="info-value">@tripToDelete.TripNumber</span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">اسم الرحلة:</span>
                            <span class="info-value">@tripToDelete.TripName</span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">تاريخ المغادرة:</span>
                            <span class="info-value">@tripToDelete.DepartureDate.ToString("dd MMMM yyyy", new CultureInfo("ar-SA"))</span>
                        </div>
                    </div>
                }
                <p class="warning-text">لا يمكن التراجع عن هذا الإجراء.</p>
            </div>

            <div class="modal-footer">
                <button class="modal-btn cancel" @onclick="CancelDelete" disabled="@isDeleting">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18" />
                        <line x1="6" y1="6" x2="18" y2="18" />
                    </svg>
                    <span>إلغاء</span>
                </button>
                <button class="modal-btn confirm" @onclick="DeleteTrip" disabled="@isDeleting">
                    @if (isDeleting)
                    {
                        <span class="btn-spinner"></span>
                        <span>جاري الحذف...</span>
                    }
                    else
                    {
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M3 6h18" />
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                        </svg>
                        <span>تأكيد الحذف</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Edit Trip Modal -->
@if (showEditModal)
{
    <div class="modal-overlay" @onclick="CancelEdit">
        <div class="modal-container edit-modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div class="modal-icon edit">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                    </svg>
                </div>
                <h3>تعديل الرحلة</h3>
            </div>

            <div class="modal-body">
                <EditForm Model="@editModel" OnValidSubmit="@HandleEditSubmit">
                    <DataAnnotationsValidator />
                    <div class="form-grid">
                        <div class="form-group">
                            <label class="form-label">اسم الرحلة</label>
                            <InputText @bind-Value="editModel.TripName" class="form-input" placeholder="أدخل اسم الرحلة" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">رقم الرحلة</label>
                            <InputText @bind-Value="editModel.TripNumber" class="form-input" placeholder="أدخل رقم الرحلة" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">تاريخ المغادرة</label>
                            <InputDate @bind-Value="editModel.DepartureDate" class="form-input" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">نوع الرحلة</label>
                            <InputSelect @bind-Value="editModel.TripType" class="form-input">
                                <option value="مباشرة">مباشرة</option>
                                <option value="غير مباشرة">غير مباشرة</option>
                            </InputSelect>
                        </div>

                        <div class="form-group">
                            <label class="form-label">عدد المقاعد الكلي</label>
                            <InputNumber @bind-Value="editModel.TotalSeats" class="form-input" min="1" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">عدد المقاعد المحجوزة</label>
                            <InputNumber @bind-Value="editModel.FilledSeats" class="form-input" min="0" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">الخطوط الجوية</label>
                            <InputSelect @bind-Value="editModel.Airline" class="form-input">
                                <option value="السعودية">السعودية</option>
                                <option value="التركية">التركية</option>
                                <option value="القطرية">القطرية</option>
                                <option value="الإماراتية">الإماراتية</option>
                                <option value="المصرية">المصرية</option>
                                <option value="المغربية">المغربية</option>
                                <option value="التونسية">التونسية</option>
                            </InputSelect>
                        </div>

                        <div class="form-group">
                            <label class="form-label">المغادرة من</label>
                            <InputText @bind-Value="editModel.DepartureFrom" class="form-input" placeholder="مدينة المغادرة" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">الوصول إلى</label>
                            <InputText @bind-Value="editModel.ArrivalTo" class="form-input" placeholder="مدينة الوصول" />
                        </div>

                        <div class="form-group full-width">
                            <label class="form-label">البرنامج</label>
                            <InputText @bind-Value="editModel.Program" class="form-input" placeholder="تفاصيل البرنامج" />
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(editErrorMessage))
                    {
                        <div class="form-error-message">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10" />
                                <line x1="12" y1="8" x2="12" y2="12" />
                                <line x1="12" y1="16" x2="12.01" y2="16" />
                            </svg>
                            <span>@editErrorMessage</span>
                        </div>
                    }

                    <div class="modal-footer">
                        <button type="button" class="modal-btn cancel" @onclick="CancelEdit" disabled="@isSaving">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="18" y1="6" x2="6" y2="18" />
                                <line x1="6" y1="6" x2="18" y2="18" />
                            </svg>
                            <span>إلغاء</span>
                        </button>
                        <button type="submit" class="modal-btn confirm edit-confirm" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="btn-spinner"></span>
                                <span>جاري الحفظ...</span>
                            }
                            else
                            {
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" />
                                    <polyline points="17 21 17 13 7 13 7 21" />
                                    <polyline points="7 3 7 8 15 8" />
                                </svg>
                                <span>حفظ التغييرات</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

