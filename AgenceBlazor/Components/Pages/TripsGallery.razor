    private async Task LoadGuideForTrip(int tripId)
    {
        existingGuide = await TripGuideService.GetGuideByTripIdAsync(tripId);
        if (existingGuide != null)
        {
            guideName = existingGuide.Name;
            guideAgency = existingGuide.Agency;
            guideGrantAmount = existingGuide.GrantAmount;
        }
        else
        {
            guideName = "";
            guideAgency = "";
            guideGrantAmount = 0;
        }
    }

    private void CancelGuide()
    {
        if (!isSavingGuide)
        {
            showGuideModal = false;
            guideTrip = null;
            existingGuide = null;
            guideError = "";
        }
    }

    private async Task SaveGuide()
    {
        Console.WriteLine("=== SaveGuide called ===");

        if (string.IsNullOrWhiteSpace(guideName))
        {
            guideError = "⚠️ الرجاء إدخال اسم المرشد";
            ShowToast(false, "الرجاء إدخال اسم المرشد");
            return;
        }

        if (string.IsNullOrWhiteSpace(guideName))
        {
            guideError = "⚠️ الرجاء إدخال اسم المرشد";
            ShowToast(false, "الرجاء إدخال اسم المرشد");
            return;
        }

        if (guideTrip == null)
        {
            guideError = "⚠️ لم يتم تحديد الرحلة";
            ShowToast(false, "لم يتم تحديد الرحلة");
            return;
        }

        try
        {
            isSavingGuide = true;
            guideError = "";
            StateHasChanged();

            var guide = new TripGuide
            {
                TripId = guideTrip.Id,
                Name = guideName.Trim(),
                Agency = string.IsNullOrWhiteSpace(guideAgency) ? null : guideAgency.Trim(),
                GrantAmount = guideGrantAmount
            };

            Console.WriteLine($"Attempting to save guide: TripId={guide.TripId}, Name='{guide.Name}', Agency='{guide.Agency}', Grant={guide.GrantAmount}");

            // Check if service is available
            if (TripGuideService == null)
            {
                Console.WriteLine("ERROR: TripGuideService is null!");
                guideError = "خطأ: خدمة المرشدين غير متاحة";
                ShowToast(false, "خدمة المرشدين غير متاحة");
                return;
            }

            var result = await TripGuideService.CreateOrUpdateGuideAsync(guide);

            if (result != null)
            {
                Console.WriteLine($"SUCCESS! Guide saved with ID: {result.Id}, Name: {result.Name}");

                // Update local dictionary
                tripGuides[guideTrip.Id] = result;

                // Close modal
                showGuideModal = false;
                guideTrip = null;
                existingGuide = null;

                ShowToast(true, $"✅ تم حفظ المرشد '{guide.Name}' بنجاح");

                // Refresh trips
                await LoadTripsAsync();
            }
            else
            {
                Console.WriteLine("ERROR: CreateOrUpdateGuideAsync returned null");
                guideError = "❌ فشل حفظ المرشد - لم يتم إرجاع بيانات";
                ShowToast(false, "فشل حفظ المرشد");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"EXCEPTION: {ex.GetType().Name}: {ex.Message}");
            Console.WriteLine($"Stack Trace: {ex.StackTrace}");

            if (ex.InnerException != null)
            {
                Console.WriteLine($"Inner Exception: {ex.InnerException.Message}");
                Console.WriteLine($"Inner Stack: {ex.InnerException.StackTrace}");
            }

            guideError = $"❌ خطأ: {ex.Message}";
            ShowToast(false, $"خطأ في حفظ المرشد: {ex.Message}");
        }
        finally
        {
            isSavingGuide = false;
            StateHasChanged();
        }
    }
