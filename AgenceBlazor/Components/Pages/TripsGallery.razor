                <div class="bkg-route">✈ @agencyBookingTrip.DepartureFrom → @agencyBookingTrip.ArrivalTo</div>
            </div>

            <!-- Body - Two Columns -->
            <div class="bkg-body">
                <!-- Left Column -->
                <div class="bkg-col">

                    @* <!-- Hotel -->
                    <div class="bkg-field">
                        <label class="bkg-label">الفندق</label>
                        <div class="bkg-btns">
                            @{
                                var agencyHotels = new[] { "زوار البيت", "جوهرة البيت", "مورو", "صلاح اجياد", "دار التقوى" };
                            }
                            @foreach (var hotel in agencyHotels)
                            {
                                <button class="bkg-btn @(selectedAgencyHotel == hotel ? "active" : "")"
                                        @onclick="() => selectedAgencyHotel = hotel">
                                    @hotel
                                </button>
                            }
                            <button class="bkg-btn @(selectedAgencyHotel == "أخرى" ? "active" : "")"
                                    @onclick='() => selectedAgencyHotel = "أخرى"'>
                                أخرى
                            </button>
                        </div>
                        @if (selectedAgencyHotel == "أخرى")
                        {
                            <input type="text" class="bkg-input" @bind="agencyCustomHotel"
                                   placeholder="أدخل اسم الفندق" style="margin-top:0.5rem;" />
