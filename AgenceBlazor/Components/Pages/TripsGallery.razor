    private Dictionary<int, TripGuide> tripGuides = new Dictionary<int, TripGuide>();

    // Guide Modal
    private bool showGuideModal = false;
    private Trip guideTrip = null;
    private TripGuide existingGuide = null;
    private string guideName = "";
    private string guideAgency = "";
    private decimal guideGrantAmount = 0;
    private bool isSavingGuide = false;
    private string guideError = "";

    // Modify OnInitializedAsync
    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine("=== TripsGallery Initializing ===");
        Console.WriteLine($"TripGuideService is null: {TripGuideService == null}");

        await LoadAgencies();
        await LoadTripsAsync();
        await LoadAllGuides();

        Console.WriteLine($"Loaded {tripGuides.Count} guides");
    }

    private async Task LoadAllGuides()
    {
        try
        {
            tripGuides.Clear();
            Console.WriteLine($"Loading guides for {allTrips.Count} trips...");

            foreach (var trip in allTrips)
            {
                var guide = await TripGuideService.GetGuideByTripIdAsync(trip.Id);
                Console.WriteLine($"Trip {trip.Id}: Guide found = {guide != null}");
                if (guide != null)
                {
                    tripGuides[trip.Id] = guide;
                    Console.WriteLine($"  - Guide: {guide.Name}, Agency: {guide.Agency}, Grant: {guide.GrantAmount}");
                }
            }

            Console.WriteLine($"Total guides loaded: {tripGuides.Count}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading guides: {ex.Message}");
        }
    }

