    private void ApplyFilters()
    {
        if (allTrips == null) return;
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            filteredTrips = allTrips.ToList();
        }
        else
        {
            var query = searchQuery.ToLower();
            filteredTrips = allTrips.Where(t =>
                (t.TripNumber?.ToLower().Contains(query) ?? false) ||
                (t.TripName?.ToLower().Contains(query) ?? false) ||
                (t.DepartureFrom?.ToLower().Contains(query) ?? false) ||
                (t.ArrivalTo?.ToLower().Contains(query) ?? false) ||
                (t.Airline?.ToLower().Contains(query) ?? false) ||
                (t.Program?.ToLower().Contains(query) ?? false) ||
                (t.TripType?.ToLower().Contains(query) ?? false)
            ).ToList();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await HandleSearch();
    }

    private async Task HandleSearch()
    {
        try
        {
            isLoading = true;
            if (!string.IsNullOrWhiteSpace(searchQuery))
                filteredTrips = await TripService.SearchTripsAsync(searchQuery);
            else
                ApplyFilters();
        }
        catch (Exception ex)
        {
            ShowToast(false, "حدث خطأ أثناء البحث");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ClearSearch()
    {
        searchQuery = "";
        ApplyFilters();
        StateHasChanged();
    }

    private async void SetSearchQuery(string query)
    {
        searchQuery = query;
        await HandleSearch();
    }

