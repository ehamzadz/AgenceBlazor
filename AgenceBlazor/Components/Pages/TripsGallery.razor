<!-- Direct Pilgrim Booking Modal -->
@if (showDirectBookingModal && directBookingTrip != null)
{
    <div class="bkg-overlay" @onclick="CancelDirectBooking">
        <div class="bkg-card bkg-agency-wide" @onclick:stopPropagation="true">
            <!-- Header -->
            <div class="bkg-header" style="background: linear-gradient(135deg, #1b5e20, #2e7d32);">
                <h3 class="bkg-title">🕋 تسجيل معتمر مباشر</h3>
                <button class="bkg-close" @onclick="CancelDirectBooking" disabled="@isDirectBookingSaving">✕</button>
            </div>

            <!-- Trip Summary -->
            <div class="bkg-summary">
                <div class="bkg-summary-row"><span class="bkg-summary-lbl">رقم الرحلة:</span><span class="bkg-summary-val">@directBookingTrip.TripNumber</span></div>
                <div class="bkg-summary-row"><span class="bkg-summary-lbl">التاريخ:</span><span class="bkg-summary-val">@directBookingTrip.DepartureDate.ToString("dd/MM/yyyy")</span></div>
                <div class="bkg-summary-row"><span class="bkg-summary-lbl">الخطوط:</span><span class="bkg-summary-val">@directBookingTrip.Airline</span></div>
                <div class="bkg-summary-row"><span class="bkg-summary-lbl">المقاعد المتبقية:</span><span class="bkg-summary-val">@directBookingTrip.RemainingSeats</span></div>
                <div class="bkg-route">✈ @directBookingTrip.DepartureFrom → @directBookingTrip.ArrivalTo</div>
            </div>

            <!-- Body - Two Columns -->
            <div class="bkg-body">
                <!-- Left Column - Personal Info -->
                <div class="bkg-col">
                    <div class="bkg-section-title">👤 معلومات المعتمر الرئيسي</div>

                    <div class="bkg-field">
                        <label class="bkg-label">الاسم الكامل *</label>
                        <input type="text" class="bkg-input" @bind="directPilgrimName" placeholder="أدخل الاسم الكامل" />
                    </div>

                    <div class="bkg-field">
                        <label class="bkg-label">رقم الهاتف *</label>
                        <input type="text" class="bkg-input" @bind="directPilgrimPhone" placeholder="رقم الهاتف" dir="ltr" />
                    </div>

                    <div class="bkg-field">
                        <label class="bkg-label">نوع الغرفة للمعتمر الرئيسي</label>
                        <div class="bkg-btns">
                            @foreach (var roomType in new[] { "جماعي", "رباعي", "ثلاثي", "ثنائي" })
                            {
                                <button class="bkg-btn @(mainPilgrimRoomType == roomType ? "active" : "")"
                                        @onclick="() => mainPilgrimRoomType = roomType">
                                    @roomType
                                </button>
                            }
                        </div>
                    </div>

                    <div class="bkg-field">
                        <label class="bkg-label">العنوان</label>
                        <input type="text" class="bkg-input" @bind="directPilgrimAddress" placeholder="العنوان (اختياري)" />
                    </div>

                    <div class="bkg-section-title" style="margin-top: 1rem;">👨‍👩‍👧‍👦 أفراد العائلة / المجموعة</div>

                    <!-- Family Members List -->
                    <div class="family-members">
                        @for (int i = 0; i < familyMembers.Count; i++)
                        {
                            var index = i; // Capture for lambda
                            <div class="family-member-row">
                                <input type="text" class="bkg-input" style="flex:1;min-width:100px;"
                                       @bind="familyMembers[index].Name"
                                       @bind:event="oninput"
                                       placeholder="الاسم" />
                                <select class="bkg-input" style="width:80px;" @bind="familyMembers[index].Relation">
                                    <option value="زوجة">زوجة</option>
                                    <option value="ابن">ابن</option>
                                    <option value="ابنة">ابنة</option>
                                    <option value="أم">أم</option>
                                    <option value="أب">أب</option>
                                    <option value="أخ">أخ</option>
                                    <option value="أخت">أخت</option>
                                    <option value="صديق">صديق</option>
                                    <option value="قريب">قريب</option>
                                </select>
                                <select class="bkg-input" style="width:80px;" @bind="familyMembers[index].RoomType">
                                    <option value="جماعي">جماعي</option>
                                    <option value="رباعي">رباعي</option>
                                    <option value="ثلاثي">ثلاثي</option>
                                    <option value="ثنائي">ثنائي</option>
                                    <option value="طفل">طفل</option>
                                    <option value="رضيع">رضيع</option>
                                </select>
                                <button class="family-remove-btn" @onclick="() => RemoveFamilyMember(index)" title="حذف">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <line x1="18" y1="6" x2="6" y2="18" />
                                        <line x1="6" y1="6" x2="18" y2="18" />
                                    </svg>
                                </button>
                            </div>
                        }
                    </div>

                    <button class="add-family-btn" @onclick="AddFamilyMember">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="12" y1="5" x2="12" y2="19" />
                            <line x1="5" y1="12" x2="19" y2="12" />
                        </svg>
                        <span>إضافة فرد</span>
                    </button>

                    @{
                        var totalPilgrims = 1 + familyMembers.Count;
                    }
                    <div class="bkg-total-pilgrims" style="margin-top: 0.5rem;">
                        <span>إجمالي المعتمرين:</span>
                        <strong>@totalPilgrims</strong>
                    </div>
                </div>

                <!-- Right Column - Hotel & Pricing -->
                <div class="bkg-col">
                    <!-- Hotel -->
                    <div class="bkg-field">
                        <label class="bkg-label">الفندق</label>
                        <div class="bkg-btns">
                            @foreach (var hotel in directBookingHotels)
                            {
                                <button class="bkg-btn @(selectedDirectHotel == hotel ? "active" : "")"
                                        @onclick="() => SelectDirectHotel(hotel)">
                                    @hotel
                                </button>
                            }
                        </div>
                    </div>

                    <!-- Room Distribution Summary -->
                    <div class="bkg-field">
                        <label class="bkg-label">ملخص توزيع الغرف</label>
                        <div class="room-summary-box">
                            <div class="room-summary-row">
                                <span>@mainPilgrimRoomType (المعتمر الرئيسي)</span><span>1</span>
                            </div>
                            @foreach (var room in familyMembers.GroupBy(m => m.RoomType).Select(g => new { Type = g.Key, Count = g.Count() }))
                            {
                                <div class="room-summary-row">
                                    <span>@room.Type</span><span>@room.Count</span>
                                </div>
                            }
                            @if (!familyMembers.Any())
                            {
                                <div class="room-summary-row" style="color:#9ca3af;">
                                    <span>لا يوجد أفراد إضافيين</span><span>-</span>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Pricing by Room Type -->
                    <div class="bkg-field">
                        <label class="bkg-label">أسعار الغرف (دج)</label>
                        <div class="bkg-room-dist">
                            @foreach (var price in new[] {
                                new { Type = "جماعي", Value = directPrices.GroupPrice, Bind = "GroupPrice" },
                                new { Type = "رباعي", Value = directPrices.QuadruplePrice, Bind = "QuadruplePrice" },
                                new { Type = "ثلاثي", Value = directPrices.TriplePrice, Bind = "TriplePrice" },
                                new { Type = "ثنائي", Value = directPrices.DoublePrice, Bind = "DoublePrice" },
                                new { Type = "طفل", Value = directPrices.ChildPrice, Bind = "ChildPrice" },
                                new { Type = "رضيع", Value = directPrices.InfantPrice, Bind = "InfantPrice" }
                            })
                            {
                                <div class="bkg-room-row">
                                    <span class="bkg-room-type">@price.Type</span>
                                    <input type="number" class="bkg-input bkg-price-input"
                                           value="@price.Value.ToString("0")"
                                           @onchange="(e) => UpdateDirectPrice(price.Bind, e)"
                                           step="1000" min="0" />
                                    <span>دج</span>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Discount -->
                    <div class="bkg-field bkg-currency">
                        <label class="bkg-label">تخفيض / خصم (دج)</label>
                        <input type="number" class="bkg-input" @bind="directDiscount" step="500" min="0" />
                        <span class="bkg-currency-sym">دج</span>
                    </div>

                    <!-- Calculations -->
                    @{
                        // Count pilgrims by room type (including main pilgrim)
                        var roomCounts = new Dictionary<string, int> { ["جماعي"] = 0, ["رباعي"] = 0, ["ثلاثي"] = 0, ["ثنائي"] = 0, ["طفل"] = 0, ["رضيع"] = 0 };
                        roomCounts[mainPilgrimRoomType] = 1;
                        foreach (var m in familyMembers)
                        {
                            if (roomCounts.ContainsKey(m.RoomType))
                                roomCounts[m.RoomType]++;
                        }

                        var directGroupTotal = roomCounts["جماعي"] * directPrices.GroupPrice;
                        var directQuadTotal = roomCounts["رباعي"] * directPrices.QuadruplePrice;
                        var directTripleTotal = roomCounts["ثلاثي"] * directPrices.TriplePrice;
                        var directDoubleTotal = roomCounts["ثنائي"] * directPrices.DoublePrice;
                        var directChildTotal = roomCounts["طفل"] * directPrices.ChildPrice;
                        var directInfantTotal = roomCounts["رضيع"] * directPrices.InfantPrice;
                        var directSubTotal = directGroupTotal + directQuadTotal + directTripleTotal + directDoubleTotal + directChildTotal + directInfantTotal;
                        var directTotalAmount = directSubTotal - directDiscount;
                        if (directTotalAmount < 0) directTotalAmount = 0;
                    }

                    <!-- Price Summary -->
                    <div class="bkg-price-summary">
                        <label class="bkg-label">ملخص المبلغ</label>
                        @if (roomCounts["جماعي"] > 0)
                        {
                            <div class="bkg-price-row"><span>جماعي (@roomCounts["جماعي"])</span><span>@directGroupTotal.ToString("N0") دج</span></div>
                        }
                        @if (roomCounts["رباعي"] > 0)
                        {
                            <div class="bkg-price-row"><span>رباعي (@roomCounts["رباعي"])</span><span>@directQuadTotal.ToString("N0") دج</span></div>
                        }
                        @if (roomCounts["ثلاثي"] > 0)
                        {
                            <div class="bkg-price-row"><span>ثلاثي (@roomCounts["ثلاثي"])</span><span>@directTripleTotal.ToString("N0") دج</span></div>
                        }
                        @if (roomCounts["ثنائي"] > 0)
                        {
                            <div class="bkg-price-row"><span>ثنائي (@roomCounts["ثنائي"])</span><span>@directDoubleTotal.ToString("N0") دج</span></div>
                        }
                        @if (roomCounts["طفل"] > 0)
                        {
                            <div class="bkg-price-row"><span>طفل (@roomCounts["طفل"])</span><span>@directChildTotal.ToString("N0") دج</span></div>
                        }
                        @if (roomCounts["رضيع"] > 0)
                        {
                            <div class="bkg-price-row"><span>رضيع (@roomCounts["رضيع"])</span><span>@directInfantTotal.ToString("N0") دج</span></div>
                        }
                        <div class="bkg-price-row" style="border-top:1px solid #e5e7eb; padding-top:0.3rem; margin-top:0.3rem;">
                            <span>المجموع الفرعي:</span><span style="font-weight:700;">@directSubTotal.ToString("N0") دج</span>
                        </div>
                        @if (directDiscount > 0)
                        {
                            <div class="bkg-price-row" style="color:#dc2626;"><span>تخفيض:</span><span>- @directDiscount.ToString("N0") دج</span></div>
                        }
                    </div>

                    <!-- Total -->
                    <div class="bkg-total">
                        <span>المبلغ الإجمالي</span>
                        <span class="bkg-total-val">@directTotalAmount.ToString("N0") دج</span>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="bkg-footer">
                <button class="bkg-btn-cancel" @onclick="CancelDirectBooking" disabled="@isDirectBookingSaving">
                    ✕ إلغاء
                </button>
                <button class="bkg-btn-save" @onclick="SaveDirectBooking" disabled="@isDirectBookingSaving">
                    @if (isDirectBookingSaving)
                    {
                        <span class="bkg-spinner"></span>
                        <span>جاري الحفظ...</span>
                    }
                    else
                    {
                        <span>🖨️ طباعة وحفظ</span>
                    }
                </button>
            </div>
        </div>
    </div>
}



@code {
    private List<Trip> allTrips = new List<Trip>();
    private List<Trip> filteredTrips = new List<Trip>();
    private string searchQuery = "";
    private bool isLoading = true;
    private int totalTrips = 0;
    private int directTrips = 0;
    private int indirectTrips = 0;

    // Delete functionality
    private bool showDeleteModal = false;
    private Trip tripToDelete = null;
    private bool isDeleting = false;

    // Toast notification
    private bool showToast = false;
    private bool toastSuccess = false;
    private string toastMessage = "";


    private async Task LoadTripsAsync()
    {
        try
        {
            isLoading = true;
            allTrips = await TripService.GetAllTripsAsync();
            totalTrips = allTrips.Count;
            directTrips = allTrips.Count(t => t.TripType == "مباشرة");
            indirectTrips = allTrips.Count(t => t.TripType == "غير مباشرة");
            ApplyFilters();
        }
        catch (Exception ex)
        {
