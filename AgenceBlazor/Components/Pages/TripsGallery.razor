    private async Task SaveAgencyBooking()
    {
        try
        {
            isAgencyBookingSaving = true;
            StateHasChanged();

            var groupTotal = roomCounts.Group * roomPrices.GroupPrice;
            var quadTotal = roomCounts.Quadruple * roomPrices.QuadruplePrice;
            var tripleTotal = roomCounts.Triple * roomPrices.TriplePrice;
            var doubleTotal = roomCounts.Double * roomPrices.DoublePrice;
            var childTotal = roomCounts.Child * roomPrices.ChildPrice;
            var infantTotal = roomCounts.Infant * roomPrices.InfantPrice;

            // Calculate total WITH reduction
            var subTotal = groupTotal + quadTotal + tripleTotal + doubleTotal + childTotal + infantTotal;
            var totalAmount = subTotal - customReduction;
            if (totalAmount < 0) totalAmount = 0;

            var adultPilgrims = roomCounts.Group + roomCounts.Quadruple + roomCounts.Triple + roomCounts.Double;
            var totalCommission = agencyCommission * adultPilgrims;

            var agency = agenciesList.FirstOrDefault(a => a.AgencyName == selectedAgency);

            var booking = new AgencyBooking
            {
                TripId = agencyBookingTrip.Id,
                AgencyId = agency?.AgencyId,
                AgencyName = selectedAgency,
                HotelName = selectedAgencyHotel == "أخرى" ? agencyCustomHotel : selectedAgencyHotel,
                GroupCount = roomCounts.Group,
                QuadrupleCount = roomCounts.Quadruple,
                TripleCount = roomCounts.Triple,
                DoubleCount = roomCounts.Double,
                ChildCount = roomCounts.Child,
                InfantCount = roomCounts.Infant,
                GroupPrice = roomPrices.GroupPrice,
                QuadruplePrice = roomPrices.QuadruplePrice,
                TriplePrice = roomPrices.TriplePrice,
                DoublePrice = roomPrices.DoublePrice,
                ChildPrice = roomPrices.ChildPrice,
                InfantPrice = roomPrices.InfantPrice,
                TotalAmount = totalAmount,
                Commission = totalCommission,
                Reduction = customReduction,
                Status = "confirmed"
            };

            var success = await AgencyBookingService.CreateAsync(booking);

            if (success)
            {
                ShowToast(true, "تم حفظ حجز الوكالة بنجاح");
                showAgencyBookingModal = false;
                agencyBookingTrip = null;

                await Task.Delay(300); // Wait for DB trigger to complete
                await LoadTripsAsync(); // Reload from DB
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            ShowToast(false, "حدث خطأ أثناء حفظ الحجز");
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            isAgencyBookingSaving = false;
            StateHasChanged();
        }
    }


