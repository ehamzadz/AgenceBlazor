    private async Task SaveDirectBooking()
    {
        if (string.IsNullOrWhiteSpace(directPilgrimName) || directBookingTrip == null) return;

        try
        {
            isDirectBookingSaving = true;
            StateHasChanged();

            // Count pilgrims by room type
            var roomCounts = new Dictionary<string, int> { ["جماعي"] = 0, ["رباعي"] = 0, ["ثلاثي"] = 0, ["ثنائي"] = 0, ["طفل"] = 0, ["رضيع"] = 0 };
            roomCounts[mainPilgrimRoomType] = 1;
            foreach (var m in familyMembers)
            {
                if (roomCounts.ContainsKey(m.RoomType))
                    roomCounts[m.RoomType]++;
            }

            var totalAmount = roomCounts["جماعي"] * directPrices.GroupPrice +
                              roomCounts["رباعي"] * directPrices.QuadruplePrice +
                              roomCounts["ثلاثي"] * directPrices.TriplePrice +
                              roomCounts["ثنائي"] * directPrices.DoublePrice +
                              roomCounts["طفل"] * directPrices.ChildPrice +
                              roomCounts["رضيع"] * directPrices.InfantPrice;

            var netAmount = totalAmount - directDiscount;
            if (netAmount < 0) netAmount = 0;

            // Save direct pilgrim
            var pilgrim = new DirectPilgrim
            {
                TripId = directBookingTrip.Id,
                MainPilgrimName = directPilgrimName,
                MainPilgrimPhone = directPilgrimPhone,
                MainPilgrimAddress = directPilgrimAddress,
                MainPilgrimRoomType = mainPilgrimRoomType,
                HotelName = selectedDirectHotel,
                TotalPilgrims = 1 + familyMembers.Count,
                TotalAmount = totalAmount,
                Discount = directDiscount,
                NetAmount = netAmount,
                PaidAmount = 0, // Initially no payment
                Notes = $"تسجيل مباشر - {directBookingTrip.TripNumber}",
                FamilyMembers = familyMembers.Select(m => new DirectPilgrimFamily
                {
                    Name = m.Name,
                    Relation = m.Relation,
                    RoomType = m.RoomType
                }).ToList()
            };

            await DirectPilgrimService.CreateAsync(pilgrim);

            // Get or create local agency
            // Get or create local agency - FIXED
            var localAgency = agenciesList.FirstOrDefault(a =>
                a.AgencyName == "الوكالة المحلية" && a.AgencyType == "مكتب");

            if (localAgency == null)
            {
                // Try to get ALL agencies including any inactive ones
                var allAgencies = await AgencyService.GetAllAgenciesAdminAsync();
                localAgency = allAgencies.FirstOrDefault(a =>
                    a.AgencyName == "الوكالة المحلية");
            }

            Guid? agencyId = localAgency?.AgencyId;

            if (agencyId == null || agencyId == Guid.Empty)
            {
                // Create only ONE local agency
                var newAgency = new Agency
                {
                    AgencyName = "الوكالة المحلية",
                    AgencyType = "مكتب",
                    City = "المكتب",
                    Status = "Active",
                    CommissionRate = 0,
                    CreatedAt = DateTime.UtcNow,
                    UpdatedAt = DateTime.UtcNow
                };
                var success = await AgencyService.CreateAgencyAsync(newAgency);
                if (success)
                {
                    agencyId = newAgency.AgencyId;
                }
            }

            // Create agency booking linked to local agency
            if (agencyId.HasValue)
            {
                var booking = new AgencyBooking
                {
                    TripId = directBookingTrip.Id,
                    AgencyId = agencyId.Value,
                    AgencyName = "الوكالة المحلية",
                    HotelName = selectedDirectHotel,
                    GroupCount = roomCounts["جماعي"],
                    QuadrupleCount = roomCounts["رباعي"],
                    TripleCount = roomCounts["ثلاثي"],
                    DoubleCount = roomCounts["ثنائي"],
                    ChildCount = roomCounts["طفل"],
                    InfantCount = roomCounts["رضيع"],
                    GroupPrice = directPrices.GroupPrice,
                    QuadruplePrice = directPrices.QuadruplePrice,
                    TriplePrice = directPrices.TriplePrice,
                    DoublePrice = directPrices.DoublePrice,
                    ChildPrice = directPrices.ChildPrice,
                    InfantPrice = directPrices.InfantPrice,
                    TotalAmount = totalAmount,
                    Commission = 0,
                    Reduction = directDiscount,
                    Status = "confirmed"
                };

                await AgencyBookingService.CreateAsync(booking);
            }

            ShowToast(true, "تم تسجيل المعتمرين بنجاح");
            showDirectBookingModal = false;
            directBookingTrip = null;
            await Task.Delay(300);
            await LoadTripsAsync();
        }
        catch (Exception ex)
        {
            ShowToast(false, "حدث خطأ أثناء الحفظ");
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            isDirectBookingSaving = false;
            StateHasChanged();
        }
    }

    
