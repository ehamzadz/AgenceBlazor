<!-- Booking Modal - Unique Classes -->
@if (showBookingModal && bookingTrip != null)
{
    <div class="bkg-overlay" @onclick="CancelBooking">
        <div class="bkg-card" @onclick:stopPropagation="true">
            <!-- Header -->
            <div class="bkg-header">
                <h3 class="bkg-title">🕋 حجز معتمر جديد</h3>
                <button class="bkg-close" @onclick="CancelBooking" disabled="@isBookingSaving">✕</button>
            </div>

            <!-- Body - Two Columns -->
            <div class="bkg-body">
                <!-- Left Column -->
                <div class="bkg-col">
                    <!-- Trip Summary -->
                    <div class="bkg-summary">
                        <div class="bkg-summary-row"><span class="bkg-summary-lbl">رقم الرحلة:</span><span class="bkg-summary-val">@bookingTrip.TripNumber</span></div>
                        <div class="bkg-summary-row"><span class="bkg-summary-lbl">التاريخ:</span><span class="bkg-summary-val">@bookingTrip.DepartureDate.ToString("dd/MM/yyyy")</span></div>
                        <div class="bkg-summary-row"><span class="bkg-summary-lbl">الخطوط:</span><span class="bkg-summary-val">@bookingTrip.Airline</span></div>
                        <div class="bkg-summary-row"><span class="bkg-summary-lbl">المقاعد:</span><span class="bkg-summary-val">@bookingTrip.RemainingSeats</span></div>
                        <div class="bkg-route">✈ @bookingTrip.DepartureFrom → @bookingTrip.ArrivalTo</div>
                    </div>

                    <!-- Pilgrim Info -->
                    <div class="bkg-field">
                        <label class="bkg-label">اسم المعتمر</label>
                        <input type="text" class="bkg-input" @bind="pilgrimName" placeholder="أدخل اسم المعتمر الكامل" />
                    </div>

                    <div class="bkg-field">
                        <label class="bkg-label">اسم الوسيط</label>
                        <input type="text" class="bkg-input" @bind="mediatorName" placeholder="اسم الوسيط (اختياري)" />
                    </div>

                    <!-- Room Type -->
                    <div class="bkg-field">
                        <label class="bkg-label">نوع الغرفة</label>
                        <div class="bkg-btns">
                            @{
                                var roomTypes = new[] { "جماعي", "رباعي", "ثلاثي", "ثنائي" };
                            }
                            @foreach (var roomType in roomTypes)
                            {
                                <button class="bkg-btn @(selectedRoomType == roomType ? "active" : "")"
                                        @onclick="() => selectedRoomType = roomType">
                                    @roomType
                                </button>
                            }
                        </div>
                    </div>

                    <!-- Hotel -->
                    <div class="bkg-field">
                        <label class="bkg-label">الفندق</label>
                        <div class="bkg-btns">
                            @{
                                var hotels = new[] { "زوار البيت", "جوهرة البيت", "مورو", "صلاح اجياد" };
                            }
                            @foreach (var hotel in hotels)
                            {
                                <button class="bkg-btn @(selectedHotel == hotel ? "active" : "")"
                                        @onclick="() => selectedHotel = hotel">
                                    @hotel
                                </button>
                            }
                            <button class="bkg-btn @(selectedHotel == "أخرى" ? "active" : "")"
                                    @onclick='() => selectedHotel = "أخرى"'>
                                أخرى
                            </button>
                        </div>
                        @if (selectedHotel == "أخرى")
                        {
                            <input type="text" class="bkg-input" @bind="customHotel"
                                   placeholder="أدخل اسم الفندق" style="margin-top:0.5rem;" />
                        }
                    </div>
                </div>

                <!-- Right Column -->
                <div class="bkg-col">
                    <!-- Number of Pilgrims -->
                    <div class="bkg-field">
                        <label class="bkg-label">عدد المعتمرين</label>
                        <div class="bkg-btns">
                            @foreach (var count in new[] { 1, 2, 3, 4, 5 })
                            {
                                <button class="bkg-btn @(pilgrimCount == count ? "active" : "")"
                                        @onclick="() => pilgrimCount = count">
                                    @count
                                </button>
                            }
                            <button class="bkg-btn @(pilgrimCount > 5 ? "active" : "")"
                                    @onclick="() => pilgrimCount = pilgrimCount > 5 ? 1 : 6">
                                +
                            </button>
                        </div>
                        @if (pilgrimCount > 5)
                        {
                            <input type="number" class="bkg-input" @bind="pilgrimCount"
                                   min="1" max="@bookingTrip.RemainingSeats" style="margin-top:0.5rem;" />
                        }
                    </div>

                    <!-- Price per person -->
                    <div class="bkg-field bkg-currency">
                        <label class="bkg-label">سعر الفرد (دج)</label>
                        <input type="number" class="bkg-input" @bind="pricePerPerson" step="1000" min="0" />
                        <span class="bkg-currency-sym">دج</span>
                    </div>

                    <!-- Commission -->
                    <div class="bkg-field bkg-currency">
                        <label class="bkg-label">عمولة الوسيط (دج)</label>
                        <input type="number" class="bkg-input" @bind="mediatorCommission" step="500" min="0" />
                        <span class="bkg-currency-sym">دج</span>
                    </div>

                    <!-- Calculations -->
                    @{
                        var totalAmount = pricePerPerson * pilgrimCount;
                        var netProfit = totalAmount - mediatorCommission;
                    }

                    <!-- Total Amount -->
                    <div class="bkg-total">
                        <span>المبلغ الإجمالي</span>
                        <span class="bkg-total-val">@totalAmount.ToString("N0") دج</span>
                    </div>

                    <!-- Net Profit -->
                    <div class="bkg-profit">
                        <span class="bkg-profit-lbl">الربح الصافي</span>
                        <span class="bkg-profit-val">@netProfit.ToString("N0") دج</span>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="bkg-footer">
                <button class="bkg-btn-save" @onclick="SaveBooking" disabled="@isBookingSaving">
                    @if (isBookingSaving)
                    {
                        <span class="bkg-spinner"></span>
                        <span>جاري الحفظ...</span>
                    }
                    else
                    {
                        <span>💾 حفظ</span>
                    }
                </button>
                <button class="bkg-btn-cancel" @onclick="CancelBooking" disabled="@isBookingSaving">
                    ✕ إلغاء
                </button>
            </div>
        </div>
    </div>
}
