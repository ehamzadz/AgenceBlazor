    private async Task DeleteGuide()
    {
        if (existingGuide == null || guideTrip == null) return;

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm",
            $"هل أنت متأكد من حذف المرشد '{existingGuide.Name}' من هذه الرحلة؟");

        if (!confirmed) return;

        try
        {
            isSavingGuide = true;
            StateHasChanged();

            var success = await TripGuideService.DeleteGuideAsync(guideTrip.Id);

            if (success)
            {
                tripGuides.Remove(guideTrip.Id);
                ShowToast(true, "تم حذف المرشد بنجاح");
                showGuideModal = false;
                guideTrip = null;
                existingGuide = null;
                await LoadTripsAsync();
                StateHasChanged();
            }
            else
            {
                guideError = "فشل حذف المرشد";
            }
        }
        catch (Exception ex)
        {
            guideError = $"حدث خطأ: {ex.Message}";
            ShowToast(false, "حدث خطأ أثناء حذف المرشد");
        }
        finally
        {
            isSavingGuide = false;
            StateHasChanged();
        }
    }

