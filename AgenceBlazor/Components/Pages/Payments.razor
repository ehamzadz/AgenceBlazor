        </div>
    </div>
</div>

<div class='line-thick'></div>

<div class='center footer'>
    <div class='footer-main bold'>شكراً لتعاملكم معنا</div>
    <div class='footer-sub'>📞 031 12 34 56 | 📍 برج بوعريريج</div>
</div>

<script>
window.onload = function() {{
    window.print();
    setTimeout(function() {{ window.close(); }}, 500);
}};
</script>
</body>
</html>";

        await JS.InvokeVoidAsync("printReceiptText", html);
    }

    private async Task DeletePayment(Payment payment) { }
}