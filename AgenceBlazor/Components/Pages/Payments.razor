{(string.IsNullOrEmpty(payment.Notes) ? "" : $@"
<div class='line-dash'></div>
<div class='center notes-box'>
    <div class='notes-label'>ملاحظة</div>
    <div class='notes-value'>{payment.Notes}</div>
</div>
")}

<div class='line-thick'></div>

<div class='stamp-area'>
    <div class='stamp-row'>
        <div class='stamp-box'>
