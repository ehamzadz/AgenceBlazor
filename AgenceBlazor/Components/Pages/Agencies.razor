    private async Task LoadPilgrimNamesForLocalAgency()
    {
        pilgrimNamesCache = new();
        var localBookings = agencyBookingsForPayment.Where(b => b.AgencyName == "الوكالة المحلية").ToList();

        if (!localBookings.Any()) return;

        try
        {
            foreach (var booking in localBookings)
            {
                if (booking.DirectPilgrimId.HasValue)
                {
                    // Get pilgrim by ID directly
                    var pilgrim = await DirectPilgrimService.GetByIdAsync(booking.DirectPilgrimId.Value);
                    pilgrimNamesCache[booking.Id] = pilgrim?.MainPilgrimName ?? "معتمر مباشر";
                }
                else
                {
                    pilgrimNamesCache[booking.Id] = "معتمر مباشر";
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading pilgrim names: {ex.Message}");
            foreach (var booking in localBookings)
                pilgrimNamesCache[booking.Id] = "حجز #{booking.Id}";
        }
    }

