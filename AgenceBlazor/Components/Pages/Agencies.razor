@page "/agencies"
@rendermode InteractiveServer
@using AgenceBlazor.Models
@using AgenceBlazor.Services
@inject AgencyService AgencyService
@inject PaymentService PaymentService
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject TreasuryService TreasuryService
@inject DirectPilgrimService DirectPilgrimService
@inject TripService TripService

<div class="agencies-container">
    <div class="page-header">
        <div class="header-content">
            <div class="header-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
            </div>
            <div>
                <h1 class="page-title">الوكالات</h1>
                <p class="page-subtitle">إدارة الوكالات وعقود السفر</p>
            </div>
        </div>
        @* <div class="header-stats">
            <div class="stat-item">
                <span class="stat-value">@agencies.Count</span>
                <span class="stat-label">وكالة</span>
            </div>
            <div class="stat-item">
                <span class="stat-value">@agencies.Count(a => a.Status == "Active")</span>
                <span class="stat-label">نشطة</span>
            </div>
            <div class="stat-item">
                <span class="stat-value">@agencies.Sum(a => a.RemainingAmount).ToString("N0")</span>
                <span class="stat-label">الديون</span>
            </div>
        </div> *@
        <div class="header-stats">
            <div class="stat-item">
                <span class="stat-value">@agencies.Count</span>
                <span class="stat-label">وكالة</span>
            </div>
            <div class="stat-item">
                <span class="stat-value">@agencies.Count(a => a.Status == "Active")</span>
                <span class="stat-label">نشطة</span>
            </div>
            <div class="stat-item">
                <span class="stat-value">@agencies.Sum(a => a.PaidAmount).ToString("N0")</span>
                <span class="stat-label">المدفوع</span>
            </div>
            <div class="stat-item">
                <span class="stat-value">@agencies.Sum(a => a.RemainingAmount).ToString("N0")</span>
                <span class="stat-label">المتبقي</span>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading-container">
            <div class="loading-spinner"></div>
            <p>جاري تحميل الوكالات...</p>
        </div>
    }
    else if (agencies.Any())
    {
        <div class="agencies-list">
            @foreach (var agency in agencies)
            {
                <div class="agency-card">
                    <div class="card-status @(agency.Status == "Active" ? "active" : "inactive")"></div>
                    <div class="card-body">
                        <!-- Agency Identity -->
                        <div class="agency-identity">
                            <div class="agency-avatar">
                                @(agency.AgencyName?.Length >= 2 ? agency.AgencyName.Substring(0, 2) : "وك")
                            </div>
                            <div class="agency-info">
                                <h3 class="agency-name">@agency.AgencyName</h3>
                                <span class="agency-address">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                        <circle cx="12" cy="10" r="3"></circle>
                                    </svg>
                                    @agency.City
                                </span>
                            </div>
                        </div>

                        <!-- Score -->
                        @{
                            var maxPilgrims = agencies.Any() ? (double)agencies.Max(a => a.PilgrimsCount) : 1.0;

                            // Pilgrims score (50%)
                            var pilgrimsScore = maxPilgrims > 0 ? ((double)agency.PilgrimsCount / maxPilgrims) * 50.0 : 0;

                            // Debt score (50%) - lower remaining debt = higher score
                            var totalAmount = (double)(agency.DebtAmount + agency.PaidAmount);
                            var debtScore = totalAmount > 0 ? (1.0 - ((double)agency.RemainingAmount / totalAmount)) * 50.0 : 50.0;

                            var score = (int)(pilgrimsScore + debtScore);
                            if (score > 100) score = 100;
                            if (score < 0) score = 0;

                            var color = score >= 80 ? "#43a047" : score >= 60 ? "#ffa726" : "#ef5350";
                        }
                        <div class="agency-score">
                            <div class="score-ring">
                                <svg width="40" height="40" viewBox="0 0 40 40">
                                    <circle cx="20" cy="20" r="17" fill="none" stroke="#e8ece8" stroke-width="2.5" />
                                    <circle cx="20" cy="20" r="17" fill="none"
                                            stroke="@color"
                                            stroke-width="2.5"
                                            stroke-dasharray="106.8"
                                            stroke-dashoffset="@(106.8 - (106.8 * score / 100))"
                                            stroke-linecap="round"
                                            transform="rotate(-90 20 20)" />
                                </svg>
                                <span class="score-text" style="color: @color">@score</span>
                            </div>
                        </div>

                        <!-- Details Chips -->
                        <div class="details-chips">
                            <div class="detail-chip">
                                <span class="chip-label">النوع</span>
                                <span class="chip-value">@agency.AgencyType</span>
                            </div>
                            <div class="detail-chip">
                                <span class="chip-label">الحالة</span>
                                <span class="chip-value status-text @(agency.Status == "Active" ? "active" : "inactive")">
                                    @(agency.Status == "Active" ? "نشطة" : "متوقفة")
                                </span>
                            </div>
                            <div class="detail-chip">
                                <span class="chip-label">العمولة</span>
                                <span class="chip-value">@agency.CommissionRate%</span>
                            </div>
                            <div class="detail-chip">
                                <span class="chip-label">العقد</span>
                                <span class="chip-value">@(agency.ContractDate?.ToString("dd/MM/yyyy") ?? "-")</span>
                            </div>
                            <div class="detail-chip">
                                <span class="chip-label">عدد المعتمرين</span>
                                <span class="chip-value">@agency.PilgrimsCount</span>
                            </div>
                        </div>

                        <!-- Financial Summary -->
                        <div class="financial-summary">
                            <div class="financial-item">
                                <div class="financial-icon debt">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <line x1="12" y1="1" x2="12" y2="23"></line>
                                        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                                    </svg>
                                </div>
                                <div class="financial-details">
                                    <span class="financial-label">الديون</span>
                                    <span class="financial-amount debt">@agency.DebtAmount.ToString("N0")</span>
                                </div>
                            </div>
                            <div class="financial-item">
                                <div class="financial-icon reduction">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                    </svg>
                                </div>
                                <div class="financial-details">
                                    <span class="financial-label">تخفيضات</span>
                                    <span class="financial-amount reduction">
                                        @(agencyReductions.ContainsKey(agency.AgencyId) ? agencyReductions[agency.AgencyId].ToString("N0") : "0")
                                    </span>
                                </div>
                            </div>
                            <div class="financial-item">
                                <div class="financial-icon paid">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                </div>
                                <div class="financial-details">
                                    <span class="financial-label">مدفوع</span>
                                    <span class="financial-amount paid">@agency.PaidAmount.ToString("N0")</span>
                                </div>
                            </div>
                            <div class="financial-item">
                                <div class="financial-icon remaining">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <polyline points="12 6 12 12 16 14"></polyline>
                                    </svg>
                                </div>
                                <div class="financial-details">
                                    <span class="financial-label">متبقي</span>
                                    <span class="financial-amount remaining @(agency.RemainingAmount > 5000 ? "urgent" : "")">
                                        @agency.RemainingAmount.ToString("N0")
                                    </span>
                                </div>
                            </div>
                        </div>
                        <!-- Actions -->
                        <div class="agency-actions">
                            <button class="agency-action-btn payment" title="تسديد" @onclick="() => AddPayment(agency)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <line x1="12" y1="1" x2="12" y2="23"></line>
                                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                                </svg>
                                <span>تسديد</span>
                            </button>
                            @* <button class="agency-action-btn bookings" title="الحجوزات" @onclick="() => ViewBookings(agency)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="3" width="18" height="18" rx="2" />
                                    <line x1="3" y1="9" x2="21" y2="9" />
                                    <line x1="9" y1="21" x2="9" y2="9" />
                                </svg>
                                <span>الحجوزات</span>
                            </button>
                            <button class="agency-action-btn edit" title="تعديل" @onclick="() => EditAgency(agency)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                                </svg>
                                <span>تعديل</span>
                            </button>
                            <button class="agency-action-btn details" title="تفاصيل" @onclick="() => ShowAgencyDetails(agency)">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <path d="M12 16v-4"></path>
                                    <path d="M12 8h.01"></path>
                                </svg>
                                <span>تفاصيل</span>
                            </button> *@
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="no-results">
            <h3>لا توجد وكالات</h3>
            <p>لم يتم العثور على أي وكالات</p>
        </div>
    }
</div>

@if (showToast)
{
    <div class="toast @(toastSuccess ? "toast-success" : "toast-error")">
        <div class="toast-icon">
            @if (toastSuccess)
            {
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                    <polyline points="22 4 12 14.01 9 11.01" />
                </svg>
            }
            else
            {
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="15" y1="9" x2="9" y2="15" />
                    <line x1="9" y1="9" x2="15" y2="15" />
                </svg>
            }
        </div>
        <span class="toast-message">@toastMessage</span>
        <button class="toast-close" @onclick="() => showToast = false">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="6" x2="6" y2="18" />
                <line x1="6" y1="6" x2="18" y2="18" />
            </svg>
        </button>
    </div>
}

