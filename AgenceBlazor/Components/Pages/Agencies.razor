    private async Task SavePayment()
{
    if (paymentAgency == null) return;

    try
    {
        isSavingPayment = true;
        StateHasChanged();

        var success = await AgencyService.AddPaymentAsync(paymentAgency.AgencyId, paymentAmount);

        if (success)
        {
            // Save payment record
            var payment = new Payment
            {
                AgencyId = paymentAgency.AgencyId,
                Amount = paymentAmount,
                PaymentMethod = selectedPaymentMethod,
                PaymentDate = DateTime.Now,
                Notes = paymentNotes
            };
            await PaymentService.CreateAsync(payment);

            // Route payment based on method
            if (selectedPaymentMethod == "نقداً")
            {
                // Cash goes to MAIN treasury
                await TreasuryService.AddAgencyPaymentToTreasuryAsync(
                    paymentAgency.AgencyId, 
                    paymentAgency.AgencyName, 
                    paymentAmount, 
                    selectedPaymentMethod, 
                    paymentNotes
                );
            }
            else
            {
                // Bank transfer, cheque, بريد go to OWNER bank account
                var ownerTransaction = new OwnerTreasuryTransaction
                {
                    Type = "deposit",
                    Source = "bank",
                    Amount = paymentAmount,
                    Description = $"دفعة من وكالة {paymentAgency.AgencyName} - {selectedPaymentMethod}",
                    TransactionDate = DateTime.UtcNow,
                    Notes = paymentNotes,
                    CreatedAt = DateTime.UtcNow,
                    UpdatedAt = DateTime.UtcNow
                };
                await TreasuryService.CreateOwnerTransactionAsync(ownerTransaction);
            }

            showPaymentModal = false;
            await LoadAgenciesAsync();
            
            var updatedAgency = agencies.FirstOrDefault(a => a.AgencyId == paymentAgency.AgencyId) ?? paymentAgency;
            await PrintReceiptDirectly(updatedAgency);
        }
        else
        {
            ShowToast(false, "فشل عملية التسديد");
        }
    }
    catch (Exception ex)
    {
        ShowToast(false, "حدث خطأ أثناء التسديد");
    }
    finally
    {
        isSavingPayment = false;
        StateHasChanged();
    }
}
