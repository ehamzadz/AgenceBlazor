<!-- Payment Modal with Booking Selection -->
@if (showPaymentModal && paymentAgency != null)
{
    <div class="pmt-overlay" @onclick="CancelPayment">
        <div class="pmt-card pmt-wide" @onclick:stopPropagation="true">
            <!-- Header -->
            <div class="pmt-header">
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <div style="background: rgba(255,255,255,0.2); padding: 0.5rem; border-radius: 10px;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                            <line x1="12" y1="1" x2="12" y2="23"></line>
                            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                        </svg>
                    </div>
                    <h3 class="pmt-title" style="color:white;">تسديد دفعة - @paymentAgency.AgencyName</h3>
                </div>
                <button class="pmt-close" @onclick="CancelPayment" disabled="@isSavingPayment">✕</button>
            </div>

            <!-- Body -->
            <div class="pmt-body">
                <!-- Agency Summary -->
                <div class="pmt-agency-summary">
                    <div class="pmt-summary-item">
                        <span>إجمالي الديون</span>
                        <span class="debt">@agencyBookingsForPayment.Sum(b => b.NetProfit).ToString("N0") دج</span>
                    </div>
                    <div class="pmt-summary-item">
                        <span>إجمالي المدفوع</span>
                        <span class="paid">@agencyBookingsForPayment.Sum(b => b.PaidAmount).ToString("N0") دج</span>
                    </div>
                    <div class="pmt-summary-item">
                        <span>المتبقي</span>
                        <span class="remaining">@agencyBookingsForPayment.Sum(b => b.RemainingAmount).ToString("N0") دج</span>
                    </div>
                </div>

                <!-- Bookings Table -->
                @if (agencyBookingsForPayment.Any())
                {
                    <div class="pmt-bookings-table-wrapper">
                        <table class="pmt-bookings-table">
                            <thead>
                                <tr>
                                    <th style="width:40px;">تحديد</th>
                                    <th>الرحلة</th>
                                    <th>الفندق</th>
                                    <th>المعتمر</th>
                                    <th>المعتمرين</th>
                                    <th>المستحق</th>
                                    <th>المدفوع</th>
                                    <th>المتبقي</th>
                                    <th style="width:130px;">مبلغ الدفع</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var booking in agencyBookingsForPayment)
                                {
                                    <tr class="@(selectedBookingIds.Contains(booking.Id) ? "selected-row" : "")">
                                        <td>
                                            <input type="checkbox" 
                                                   checked="@selectedBookingIds.Contains(booking.Id)"
                                                   @onchange="() => ToggleBookingSelection(booking.Id)" />
                                        </td>
                                        <td>
                                            <span class="booking-trip-number">@booking.Trip?.TripNumber</span>
                                            <span class="booking-trip-date">@booking.Trip?.DepartureDate.ToString("dd/MM/yyyy")</span>
                                        </td>
                                        <td>@booking.HotelName</td>
                                        <td>
                                            @if (booking.AgencyName == "الوكالة المحلية")
                                            {
                                                <span class="pilgrim-name-badge">@GetDirectPilgrimName(booking)</span>
                                            }
                                            else
                                            {
                                                <span style="color:#94a3b8;">-</span>
                                            }
                                        </td>
                                        <td>@booking.TotalPilgrims</td>
                                        <td class="cell-amount">@booking.NetProfit.ToString("N0")</td>
                                        <td class="cell-amount" style="color:#1565c0;">@booking.PaidAmount.ToString("N0")</td>
                                        <td class="cell-amount" style="color:@(booking.RemainingAmount > 0 ? "#dc2626" : "#2e7d32");">@booking.RemainingAmount.ToString("N0")</td>
                                        <td>
                                            @if (selectedBookingIds.Contains(booking.Id))
                                            {
                                                <input type="number" 
                                                       class="pmt-booking-amount-input"
                                                       value="@GetBookingPaymentAmount(booking.Id)"
                                                       @oninput="(e) => UpdateBookingPaymentAmount(booking.Id, e)"
                                                       step="1000" min="0" max="@booking.RemainingAmount"
                                                       placeholder="المبلغ" />
                                            }
                                            else
                                            {
                                                <span class="not-selected">-</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="pmt-no-bookings">لا توجد حجوزات مستحقة لهذه الوكالة</div>
                }

                <!-- Payment Summary -->
                @{
                    var totalSelectedPayment = bookingPaymentAmounts.Values.Sum();
                }
                <div class="pmt-payment-summary">
                    <div class="pmt-summary-item">
                        <span>إجمالي المبلغ المحدد للدفع</span>
                        <span class="total-pay">@totalSelectedPayment.ToString("N0") دج</span>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(paymentError))
                {
                    <div class="pmt-error">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10" />
                            <line x1="12" y1="8" x2="12" y2="12" />
                            <line x1="12" y1="16" x2="12.01" y2="16" />
                        </svg>
                        <span>@paymentError</span>
                    </div>
                }

                <!-- Payment Method -->
                <div class="pmt-field">
                    <label class="pmt-label">طريقة الدفع</label>
                    <div class="pmt-btns">
                        @foreach (var method in new[] { "نقداً", "شيك", "تحويل بنكي", "بريد" })
                        {
                            <button class="pmt-btn @(selectedPaymentMethod == method ? "active" : "")"
                                    @onclick="() => selectedPaymentMethod = method">
                                @method
                            </button>
                        }
                    </div>
                </div>

                <!-- Notes -->
                <div class="pmt-field">
                    <label class="pmt-label">ملاحظات</label>
                    <input type="text" class="pmt-input" @bind="paymentNotes" placeholder="ملاحظات (اختياري)" />
                </div>
            </div>

            <!-- Footer -->
            <div class="pmt-footer">
                <button class="pmt-btn-cancel" @onclick="CancelPayment" disabled="@isSavingPayment">
                    ✕ إلغاء
                </button>
                <button class="pmt-btn-save" @onclick="SavePaymentWithBookings"
                        disabled="@(isSavingPayment || totalSelectedPayment <= 0 || !string.IsNullOrEmpty(paymentError))">
                    @if (isSavingPayment)
                    {
                        <span class="pmt-spinner"></span>
                        <span>جاري الحفظ...</span>
                    }
                    else
                    {
                        <span>💾 تأكيد الدفع (@totalSelectedPayment.ToString("N0") دج)</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<Agency> agencies = new();
    private bool isLoading = true;
    private Dictionary<Guid, decimal> agencyReductions = new();

    // Payment Modal
    private bool showPaymentModal = false;
    private Agency paymentAgency = null;
    private bool isSavingPayment = false;
    private string selectedPaymentMethod = "نقداً";
    private string paymentNotes = "";
    private List<AgencyBooking> agencyBookingsForPayment = new();
    private HashSet<int> selectedBookingIds = new();
    private Dictionary<int, decimal> bookingPaymentAmounts = new();

    // Inject AgencyBookingService
    @inject AgencyBookingService AgencyBookingService

    protected override async Task OnInitializedAsync()
    {
        await LoadAgenciesAsync();
    }

    private async Task LoadAgenciesAsync()
    {
        try
        {
            isLoading = true;
            agencies = await AgencyService.GetAllAgenciesAdminAsync();
            agencyReductions = await AgencyService.GetReductionsByAgencyAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading agencies: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task AddPayment(Agency agency)
    {
        paymentAgency = agency;
        selectedPaymentMethod = "نقداً";
        paymentNotes = "";
        selectedBookingIds = new();
        bookingPaymentAmounts = new();

        // Load agency bookings with remaining debt
        await LoadAgencyBookingsForPayment(agency.AgencyId);

        showPaymentModal = true;
        StateHasChanged();
    }

    private async Task LoadAgencyBookingsForPayment(Guid agencyId)
    {
        try
        {
            var allBookings = await AgencyBookingService.GetAllAsync();
            agencyBookingsForPayment = allBookings
                .Where(b => b.AgencyId == agencyId && b.RemainingAmount > 0)
                .OrderByDescending(b => b.CreatedAt)
                .ToList();

            await LoadPilgrimNamesForLocalAgency();  // ADD THIS
            StateHasChanged();
        }
        catch
        {
            agencyBookingsForPayment = new();
        }
    }

    private void ToggleBookingSelection(int bookingId)
    {
        if (selectedBookingIds.Contains(bookingId))
        {
            selectedBookingIds.Remove(bookingId);
            bookingPaymentAmounts.Remove(bookingId);
        }
        else
        {
            selectedBookingIds.Add(bookingId);
            // Default to remaining amount
            var booking = agencyBookingsForPayment.FirstOrDefault(b => b.Id == bookingId);
            if (booking != null)
            {
                bookingPaymentAmounts[bookingId] = booking.RemainingAmount;
            }
        }
        StateHasChanged();
    }

    private decimal GetBookingPaymentAmount(int bookingId)
    {
        return bookingPaymentAmounts.ContainsKey(bookingId) ? bookingPaymentAmounts[bookingId] : 0;
    }

    private void UpdateBookingPaymentAmount(int bookingId, ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var amount))
        {
            var booking = agencyBookingsForPayment.FirstOrDefault(b => b.Id == bookingId);
            if (booking == null) return;

            // Get total of OTHER selected bookings
            var otherBookingsTotal = selectedBookingIds
                .Where(id => id != bookingId)
                .Sum(id => bookingPaymentAmounts.GetValueOrDefault(id, 0));

            // Max this booking can take
            var maxForThisBooking = booking.RemainingAmount;

            // Validate
            if (amount < 0) amount = 0;

            // Don't enforce single booking minimum here, validate on save
            if (amount > maxForThisBooking)
            {
                amount = maxForThisBooking;
            }

            bookingPaymentAmounts[bookingId] = amount;
            paymentError = ""; // Clear error when user changes amount
        }
        StateHasChanged();
    }

    private string paymentError = "";

    private string ValidatePaymentAmounts()
    {
        var totalSelected = bookingPaymentAmounts.Values.Sum();

        if (totalSelected <= 0)
            return "يجب إدخال مبلغ الدفع";

        if (selectedBookingIds.Count == 1)
        {
            // Single booking: any amount from 1 to RemainingAmount
            var bookingId = selectedBookingIds.First();
            var booking = agencyBookingsForPayment.First(b => b.Id == bookingId);
            var amount = bookingPaymentAmounts.GetValueOrDefault(bookingId, 0);

            if (amount <= 0)
                return "يجب أن يكون المبلغ أكبر من 0";

            if (amount > booking.RemainingAmount)
                return $"المبلغ يتجاوز المبلغ المتبقي للحجز ({booking.RemainingAmount:N0} دج)";
        }
        else if (selectedBookingIds.Count > 1)
        {
            // Multiple bookings: total must be >= max single remaining AND <= sum of all remaining
            var maxSingleRemaining = selectedBookingIds.Max(id =>
                agencyBookingsForPayment.First(b => b.Id == id).RemainingAmount);

            var totalRemaining = selectedBookingIds.Sum(id =>
                        agencyBookingsForPayment.First(b => b.Id == id).RemainingAmount);

            if (totalSelected < 1)
                return "يجب أن يكون إجمالي المبلغ أكبر من 0";

            if (totalSelected > totalRemaining)
                return $"إجمالي المبلغ ({totalSelected:N0} دج) يتجاوز مجموع المبالغ المتبقية ({totalRemaining:N0} دج)";
        }

        return ""; // No error
    }

    private async Task SavePaymentWithBookings()
    {
        if (paymentAgency == null || !selectedBookingIds.Any()) return;

        // Validate
        var error = ValidatePaymentAmounts();
        if (!string.IsNullOrEmpty(error))
        {
            paymentError = error;
            ShowToast(false, error);
            StateHasChanged();
            return;
        }

        try
        {
            isSavingPayment = true;
            paymentError = "";
            StateHasChanged();

            var totalAmount = bookingPaymentAmounts.Values.Sum();

            // Update agency paid amount
            await AgencyService.AddPaymentAsync(paymentAgency.AgencyId, totalAmount);

            // Create payments for each selected booking
            foreach (var bookingId in selectedBookingIds)
            {
                var amount = bookingPaymentAmounts.GetValueOrDefault(bookingId, 0);
                if (amount <= 0) continue;

                var payment = new Payment
                {
                    AgencyId = paymentAgency.AgencyId,
                    BookingId = bookingId,
                    Amount = amount,
                    PaymentMethod = selectedPaymentMethod,
                    PaymentDate = DateTime.UtcNow,
                    Notes = paymentNotes
                };
                await PaymentService.CreateAsync(payment);
            }

            // Route payment based on method
            if (selectedPaymentMethod == "نقداً")
            {
                await TreasuryService.AddAgencyPaymentToTreasuryAsync(
                    paymentAgency.AgencyId,
                    paymentAgency.AgencyName,
                    totalAmount,
                    selectedPaymentMethod,
                    paymentNotes
                );
            }
            else
            {
                var ownerTransaction = new OwnerTreasuryTransaction
                {
                    Type = "deposit",
                    Source = "bank",
                    Amount = totalAmount,
                    Description = $"دفعة من وكالة {paymentAgency.AgencyName} - {selectedPaymentMethod}",
                    TransactionDate = DateTime.UtcNow,
                    Notes = paymentNotes,
                    CreatedAt = DateTime.UtcNow,
                    UpdatedAt = DateTime.UtcNow
                };
                await TreasuryService.CreateOwnerTransactionAsync(ownerTransaction);
            }

            showPaymentModal = false;
            paymentAgency = null;
            agencyBookingsForPayment = new();
            selectedBookingIds = new();
            bookingPaymentAmounts = new();
            paymentError = "";
            await LoadAgenciesAsync();
            ShowToast(true, "تم التسديد بنجاح");
        }
        catch (Exception ex)
        {
            ShowToast(false, "حدث خطأ أثناء التسديد");
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            isSavingPayment = false;
            StateHasChanged();
        }
    }

    
    private void CancelPayment()
    {
        if (!isSavingPayment)
        {
            showPaymentModal = false;
            paymentAgency = null;
            agencyBookingsForPayment = new();
            selectedBookingIds = new();
            bookingPaymentAmounts = new();
        }
    }

