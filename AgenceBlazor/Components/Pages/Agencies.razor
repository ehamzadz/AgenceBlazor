private async Task PrintReceiptDirectly(Agency agency)
{
    var receiptNumber = $"REC-{DateTime.Now:yyyyMMdd}-{new Random().Next(1000, 9999)}";
    var receiptDate = DateTime.Now.ToString("dd/MM/yyyy");
    
    var html = $@"<!DOCTYPE html>
<html lang='ar' dir='rtl'>
<head><meta charset='UTF-8'><title>إيصال دفع</title>
<style>
    @@import url('https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&family=Cairo:wght@600;700;800&display=swap');
    *{{margin:0;padding:0;box-sizing:border-box}}
    body{{display:flex;justify-content:center;padding:0;background:#fff;font-family:'Tajawal','Cairo',sans-serif}}
    .ticket{{width:80mm;background:#fff;padding:4mm 3mm;line-height:1.3;font-size:8px}}
    .center{{text-align:center}}
    .bold{{font-weight:700}}
    .hr{{border:none;border-top:1px solid #000;margin:2mm 0}}
    .hr-dot{{border:none;border-top:1px dotted #999;margin:1.5mm 0}}
    
    .header-logo{{font-size:14px;font-weight:900;letter-spacing:3px}}
    .header-name{{font-size:9px;font-weight:700;margin:0.5mm 0}}
    .header-sub{{font-size:6px;color:#555}}
    
    .title{{font-size:10px;font-weight:800;letter-spacing:1px}}
    .title-sub{{font-size:6px;color:#666;margin:0.3mm 0}}
    
    .info-row{{display:flex;justify-content:space-between;font-size:8px;margin:0.3mm 0}}
    .info-row span:first-child{{color:#555}}
    .info-row .val{{font-weight:700}}
    
    .amount-box{{text-align:center;margin:2mm 0}}
    .amount-label{{font-size:7px;color:#888;letter-spacing:1px}}
    .amount-value{{font-size:20px;font-weight:900;font-family:'Cairo',monospace}}
    .amount-currency{{font-size:8px;color:#555}}
    
    .method-box{{text-align:center;margin:1mm 0}}
    .method-text{{font-size:8px;color:#444}}
    
    .stamp-area{{display:flex;justify-content:space-between;align-items:flex-end;gap:3mm;margin:4mm 0 2mm 0}}
    .stamp-box{{text-align:center}}
    .stamp-box-inner{{width:26mm;height:15mm;border:1px dashed #999;border-radius:2px;display:flex;align-items:center;justify-content:center;color:#bbb;font-size:7px;margin-bottom:0.5mm}}
    .stamp-box-inner::after{{content:'ختم الوكالة'}}
    .sig-box{{flex:1}}
    .sig-line{{border-top:0.5px solid #999;margin-bottom:0.3mm}}
    .sig-text{{font-size:6px;color:#888}}
    
    .footer-thanks{{font-size:8px;font-weight:600;margin-bottom:0.3mm}}
    .footer-info{{font-size:6px;color:#888}}
    
    @@page{{size:80mm auto;margin:0}}
    @@media print{{body{{background:#fff}}.ticket{{box-shadow:none}}}}
</style></head>
<body>
<div class='ticket'>
    <div class='center header-logo'>خضور</div>
    <div class='center header-name'>وكالة خضور للسياحة والعمرة</div>
    <div class='center header-sub'>KHODOR TRAVEL & UMRAH</div>
    
    <hr class='hr'>
    
    <div class='center title'>إيصال دفع</div>
    <div class='center title-sub'>{receiptNumber} | {receiptDate}</div>
    
    <hr class='hr-dot'>
    
    <div class='info-row'><span>الوكالة</span><span class='val'>{agency.AgencyName}</span></div>
    <div class='info-row'><span>المدينة</span><span class='val'>{agency.City}</span></div>
    <div class='info-row'><span>الهاتف</span><span class='val'>{agency.Phone ?? "031 12 34 56"}</span></div>
    
    <hr class='hr'>
    
    <div class='amount-box'>
        <div class='amount-label'>المبلغ المدفوع</div>
        <div class='amount-value'>{paymentAmount.ToString("N0")}</div>
        <div class='amount-currency'>دينار جزائري</div>
    </div>
    
    <div class='method-box'>
        <span>طريقة الدفع: </span><span class='bold'>{selectedPaymentMethod}</span>
    </div>
    
    {(string.IsNullOrEmpty(paymentNotes) ? "" : $"<div class='center' style='font-size:7px;color:#666;margin:1mm 0'>{paymentNotes}</div>")}
    
    <hr class='hr'>
    
    <div class='stamp-area'>
        <div class='stamp-box'>
            <div class='stamp-box-inner'></div>
        </div>
        <div class='sig-box'>
            <div class='sig-line'></div>
            <div class='sig-text'>توقيع المستلم</div>
        </div>
    </div>
    
    <hr class='hr'>
    
    <div class='center footer-thanks'>شكراً لتعاملكم معنا</div>
    <div class='center footer-info'>س.ت: 123456789 | ض.م: 987654321</div>
    <div class='center footer-info'>031 12 34 56 | شارع العربي بن مهيدي، قسنطينة</div>
</div>
<script>window.print();window.close();</script>
</body></html>";

    await JS.InvokeVoidAsync("printReceipt", html);
}

}