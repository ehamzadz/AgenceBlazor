    private async Task AddPayment(AgencyBooking booking)
    {
        paymentBooking = booking;
        paymentAmount = 0;
        paymentMethod = "نقداً";
        paymentNotes = "";
        paymentError = "";
        bookingPayments = allPayments?.Where(p => p.BookingId == booking.Id).ToList() ?? new();
        showPaymentModal = true;
        StateHasChanged();
    }
    private string paymentError = "";  // Add this to your variables

    private async Task SavePayment()
    {
        if (paymentBooking == null || paymentAmount <= 0) return;

        // Validate amount doesn't exceed remaining
        if (paymentAmount > remainingForBooking)
        {
            paymentError = $"⚠️ المبلغ يتجاوز المبلغ المتبقي ({remainingForBooking:N0} دج)";
            StateHasChanged();
            return;
        }

        try
        {
            isSavingPayment = true;
            paymentError = "";
            StateHasChanged();

            var agency = agencies.FirstOrDefault(a => a.AgencyName == paymentBooking.AgencyName);

            var payment = new Payment
            {
                AgencyId = agency?.AgencyId ?? Guid.Empty,
                BookingId = paymentBooking.Id,
                Amount = paymentAmount,
                PaymentMethod = paymentMethod,
                PaymentDate = DateTime.UtcNow,
                Notes = paymentNotes
            };

            await PaymentService.CreateAsync(payment);

            showPaymentModal = false;
            paymentBooking = null;
            paymentError = "";
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
            paymentError = "حدث خطأ أثناء الحفظ";
        }
        finally { isSavingPayment = false; StateHasChanged(); }
    }

    private void ApplyFilters()
    {
        var query = allBookings.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var q = searchQuery.ToLower();
            query = query.Where(b =>
                (b.AgencyName?.ToLower().Contains(q) ?? false) ||
                (b.HotelName?.ToLower().Contains(q) ?? false) ||
                (b.Trip?.TripNumber?.ToLower().Contains(q) ?? false) ||
                (b.Trip?.TripName?.ToLower().Contains(q) ?? false) ||
                (b.Trip?.Airline?.ToLower().Contains(q) ?? false) ||
                (b.Trip?.DepartureFrom?.ToLower().Contains(q) ?? false) ||
                (b.Trip?.ArrivalTo?.ToLower().Contains(q) ?? false) ||
                (b.Status?.ToLower().Contains(q) ?? false));
        }

        if (!string.IsNullOrWhiteSpace(filterMonth) && int.TryParse(filterMonth, out var month))
            query = query.Where(b => b.CreatedAt.Month == month && b.CreatedAt.Year == DateTime.Now.Year);

        if (!string.IsNullOrWhiteSpace(filterTripId) && int.TryParse(filterTripId, out var tripId))
            query = query.Where(b => b.TripId == tripId);

        if (!string.IsNullOrWhiteSpace(filterAgency))
            query = query.Where(b => b.AgencyName == filterAgency);

        filteredBookings = query.OrderByDescending(b => b.CreatedAt).ToList();
    }

    private async Task OnMonthChanged(ChangeEventArgs e) { filterMonth = e.Value?.ToString() ?? ""; ApplyFilters(); StateHasChanged(); }
    private async Task OnTripChanged(ChangeEventArgs e) { filterTripId = e.Value?.ToString() ?? ""; ApplyFilters(); StateHasChanged(); }
    private async Task OnAgencyFilterChanged(ChangeEventArgs e) { filterAgency = e.Value?.ToString() ?? ""; ApplyFilters(); StateHasChanged(); }

    private async Task HandleKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") await HandleSearch(); }
    private async Task HandleSearch() { ApplyFilters(); StateHasChanged(); }
    private async Task ClearSearch() { searchQuery = ""; ApplyFilters(); }
    private void ResetFilters() { searchQuery = ""; filterMonth = DateTime.Now.Month.ToString(); filterTripId = ""; filterAgency = ""; ApplyFilters(); StateHasChanged(); }

