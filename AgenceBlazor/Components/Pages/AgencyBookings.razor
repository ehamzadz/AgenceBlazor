    private async Task EditBooking(AgencyBooking booking)
    {
        Console.WriteLine("=== EditBooking called ===");
        Console.WriteLine($"Booking ID: {booking.Id}");
        Console.WriteLine($"Agency: {booking.AgencyName}");
        editBookingModel = booking;

        // Load trip info
        editTripInfo = trips.FirstOrDefault(t => t.Id == booking.TripId);

        // Load hotels
        await LoadEditHotels(booking.TripId);

        // Set values
        editSelectedAgency = booking.AgencyName ?? "";
        editSelectedHotel = booking.HotelName ?? "";
        editCustomHotel = "";

        // Calculate commission per adult
        var adultCount = booking.TotalPilgrims - booking.ChildCount - booking.InfantCount;
        editCommission = adultCount > 0 ? booking.Commission / adultCount : 0;
        editReduction = booking.Reduction;

        editRoomCounts = new EditRoomCounts
        {
            Group = booking.GroupCount,
            Quadruple = booking.QuadrupleCount,
            Triple = booking.TripleCount,
            Double = booking.DoubleCount,
            Child = booking.ChildCount,
            Infant = booking.InfantCount
        };

        editRoomPrices = new EditRoomPrices
        {
            GroupPrice = booking.GroupPrice,
            QuadruplePrice = booking.QuadruplePrice,
            TriplePrice = booking.TriplePrice,
            DoublePrice = booking.DoublePrice,
            ChildPrice = booking.ChildPrice,
            InfantPrice = booking.InfantPrice
        };

        showEditBookingModal = true;
        StateHasChanged();
    }

    private async Task LoadEditHotels(int tripId)
    {
        try
        {
            editHotelList = await HotelService.GetHotelNamesByTripIdAsync(tripId);
            if (!editHotelList.Any()) editHotelList = new List<string> { "لا توجد فنادق" };
        }
        catch { editHotelList = new List<string> { "لا توجد فنادق" }; }
    }

    private async Task SelectEditHotel(string hotel)
    {
        editSelectedHotel = hotel;
        if (hotel != "أخرى" && hotel != "لا توجد فنادق" && editBookingModel != null)
        {
            var hotelData = await HotelService.GetHotelByNameAndTripAsync(hotel, editBookingModel.TripId);
            if (hotelData != null)
            {
                editRoomPrices = new EditRoomPrices
                {
                    GroupPrice = hotelData.GroupPrice,
                    QuadruplePrice = hotelData.QuadruplePrice,
                    TriplePrice = hotelData.TriplePrice,
                    DoublePrice = hotelData.DoublePrice,
                    ChildPrice = hotelData.ChildPrice,
                    InfantPrice = hotelData.InfantPrice
                };
                StateHasChanged();
            }
        }
    }

    private void CancelEditBooking()
    {
        if (!isEditBookingSaving)
        {
            showEditBookingModal = false;
            editBookingModel = null;
        }
    }

    private async Task SaveEditBooking()
    {
        if (editBookingModel == null) return;

        try
        {
            isEditBookingSaving = true;
            StateHasChanged();

            var eGroupTotal = editRoomCounts.Group * editRoomPrices.GroupPrice;
            var eQuadTotal = editRoomCounts.Quadruple * editRoomPrices.QuadruplePrice;
            var eTripleTotal = editRoomCounts.Triple * editRoomPrices.TriplePrice;
            var eDoubleTotal = editRoomCounts.Double * editRoomPrices.DoublePrice;
            var eChildTotal = editRoomCounts.Child * editRoomPrices.ChildPrice;
            var eInfantTotal = editRoomCounts.Infant * editRoomPrices.InfantPrice;
            var eSubTotal = eGroupTotal + eQuadTotal + eTripleTotal + eDoubleTotal + eChildTotal + eInfantTotal;
            var eTotalAmount = eSubTotal - editReduction;
            if (eTotalAmount < 0) eTotalAmount = 0;
            var eAdultPilgrims = editRoomCounts.Group + editRoomCounts.Quadruple + editRoomCounts.Triple + editRoomCounts.Double;
            var eTotalCommission = editCommission * eAdultPilgrims;

            var agency = agencies.FirstOrDefault(a => a.AgencyName == editSelectedAgency);

            // Update booking
            editBookingModel.AgencyId = agency?.AgencyId ?? Guid.Empty;
            editBookingModel.AgencyName = editSelectedAgency;
            editBookingModel.HotelName = editSelectedHotel == "أخرى" ? editCustomHotel : editSelectedHotel;
            editBookingModel.GroupCount = editRoomCounts.Group;
            editBookingModel.QuadrupleCount = editRoomCounts.Quadruple;
            editBookingModel.TripleCount = editRoomCounts.Triple;
            editBookingModel.DoubleCount = editRoomCounts.Double;
            editBookingModel.ChildCount = editRoomCounts.Child;
            editBookingModel.InfantCount = editRoomCounts.Infant;
            editBookingModel.GroupPrice = editRoomPrices.GroupPrice;
            editBookingModel.QuadruplePrice = editRoomPrices.QuadruplePrice;
            editBookingModel.TriplePrice = editRoomPrices.TriplePrice;
            editBookingModel.DoublePrice = editRoomPrices.DoublePrice;
            editBookingModel.ChildPrice = editRoomPrices.ChildPrice;
            editBookingModel.InfantPrice = editRoomPrices.InfantPrice;
            editBookingModel.TotalAmount = eTotalAmount;
            editBookingModel.Commission = eTotalCommission;
            editBookingModel.Reduction = editReduction;
            editBookingModel.UpdatedAt = DateTime.UtcNow;

            var success = await AgencyBookingService.UpdateAsync(editBookingModel);

            if (success)
            {
                showEditBookingModal = false;
                editBookingModel = null;
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Edit error: {ex.Message}");
        }
        finally
        {
            isEditBookingSaving = false;
            StateHasChanged();
        }
    }
}