@page "/agency-bookings"
@rendermode InteractiveServer
@using System.Globalization
@using AgenceBlazor.Models
@using AgenceBlazor.Services
@inject AgencyBookingService AgencyBookingService
@inject TripService TripService
@inject AgencyService AgencyService
@inject PaymentService PaymentService
@inject IJSRuntime JS
@inject HotelService HotelService

<div class="bookings-container">
    <div class="page-header">
        <div class="header-content">
            <div class="header-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                    <rect x="3" y="3" width="18" height="18" rx="2" />
                    <line x1="3" y1="9" x2="21" y2="9" />
                    <line x1="9" y1="21" x2="9" y2="9" />
                </svg>
            </div>
            <div>
                <h1 class="page-title">حجوزات الوكالات</h1>
                <p class="page-subtitle">سجل حجوزات الوكالات والمعاملات المالية</p>
            </div>
        </div>
        <div class="header-stats">
            <div class="stat-item">
                <span class="stat-value">@filteredBookings.Count</span>
                <span class="stat-label">حجز</span>
            </div>
            <div class="stat-item">
                <span class="stat-value">@filteredBookings.Sum(b => b.TotalPilgrims)</span>
                <span class="stat-label">معتمر</span>
            </div>
            <div class="stat-item">
                <span class="stat-value">@filteredBookings.Sum(b => b.TotalAmount).ToString("N0")</span>
                <span class="stat-label">الإجمالي</span>
            </div>
            <div class="stat-item">
                <span class="stat-value">@filteredBookings.Sum(b => b.Reduction).ToString("N0")</span>
                <span class="stat-label">الخصم</span>
            </div>
            <div class="stat-item">
                <span class="stat-value">@filteredBookings.Sum(b => b.Commission).ToString("N0")</span>
                <span class="stat-label">العمولة</span>
            </div>
            <div class="stat-item">
                <span class="stat-value">@filteredBookings.Sum(b => b.NetProfit).ToString("N0")</span>
                <span class="stat-label">الصافي</span>
            </div>
            <div class="stat-item">
                <span class="stat-value">@filteredBookings.Sum(b => b.PaidAmount).ToString("N0")</span>
                <span class="stat-label">المدفوع</span>
            </div>
            <div class="stat-item">
                <span class="stat-value">@filteredBookings.Sum(b => b.RemainingAmount).ToString("N0")</span>
                <span class="stat-label">المتبقي</span>
            </div>
            <div class="stat-item">
                <span class="stat-value">@filteredBookings.Where(b => b.RemainingAmount == 0).Count()</span>
                <span class="stat-label">مكتمل</span>
            </div>
            <div class="stat-item">
                <span class="stat-value">@filteredBookings.Where(b => b.RemainingAmount > 0).Count()</span>
                <span class="stat-label">قيد التسديد</span>
            </div>
            <div class="stat-item">
                <span class="stat-value">@filteredBookings.Sum(b => b.TotalAmount - b.NetProfit).ToString("N0")</span>
                <span class="stat-label">إجمالي العمولة + الخصم</span>
            </div>
            <div class="stat-item">
                <span class="stat-value">@((filteredBookings.Sum(b => b.PaidAmount) * 100 / Math.Max(filteredBookings.Sum(b => b.NetProfit), 1)).ToString("F1"))%</span>
                <span class="stat-label">نسبة التحصيل</span>
            </div>
        </div>
    </div>

    <div class="search-section">
        <div class="search-container">
            <div class="search-wrapper">
                <div class="search-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8" />
                        <path d="M21 21l-4.35-4.35" />
                    </svg>
                </div>
                <input type="text" class="search-input" placeholder="ابحث عن حجز..."
                       @bind="searchQuery" @bind:event="oninput" @onkeydown="HandleKeyDown" />
                <button class="search-clear" @onclick="ClearSearch" style="@(string.IsNullOrEmpty(searchQuery) ? "display: none;" : "")">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18" />
                        <line x1="6" y1="6" x2="18" y2="18" />
                    </svg>
                </button>
                <button class="search-btn" @onclick="HandleSearch"><span>بحث</span></button>
            </div>
            <div class="filter-row">
                <select class="filter-select" value="@filterMonth" @onchange="OnMonthChanged">
                    <option value="">كل الأشهر</option>
                    <option value="1">يناير</option>
                    <option value="2">فبراير</option>
                    <option value="3">مارس</option>
                    <option value="4">أبريل</option>
                    <option value="5">ماي</option>
                    <option value="6">جوان</option>
                    <option value="7">جويلية</option>
                    <option value="8">أوت</option>
                    <option value="9">سبتمبر</option>
                    <option value="10">أكتوبر</option>
                    <option value="11">نوفمبر</option>
                    <option value="12">ديسمبر</option>
                </select>
                <select class="filter-select" value="@filterTripId" @onchange="OnTripChanged">
                    <option value="">جميع الرحلات</option>
                    @foreach (var trip in trips)
                    {
                        <option value="@trip.Id">@trip.TripNumber - @trip.TripName</option>
                    }
                </select>
                <select class="filter-select" value="@filterAgency" @onchange="OnAgencyFilterChanged">
                    <option value="">جميع الوكالات</option>
                    @foreach (var agency in agencies)
                    {
                        <option value="@agency.AgencyName">@agency.AgencyName</option>
                    }
                </select>
                <button class="filter-reset" @onclick="ResetFilters">إعادة تعيين</button>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading-container"><div class="loading-spinner"></div><p>جاري تحميل الحجوزات...</p></div>
    }
    else if (filteredBookings.Any())
    {
        <div class="bookings-table-wrapper">
            <table class="bookings-table">
                <thead>
                    <tr>
                        <th>التاريخ</th>
                        <th>الرحلة</th>
                        <th>اسم الرحلة</th>
                        <th>الوكالة</th>
                        <th>الفندق</th>
                        <th>الغرف</th>
                        <th>المعتمرين</th>
                        <th>الإجمالي</th>
                        <th>الخصم</th>
                        <th>العمولة</th>
                        <th>الصافي</th>
                        <th>المدفوع</th>
                        <th>المتبقي</th>
                        <th>إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in filteredBookings)
                    {
                        <tr>
                            <td class="cell-date">
                                <div class="date-main">@booking.CreatedAt.ToString("dd/MM/yyyy")</div>
                                <div class="date-time">@booking.CreatedAt.ToString("HH:mm")</div>
                            </td>
                            <td class="cell-trip">
                                <span class="trip-number">@booking.Trip?.TripNumber</span>
                                <span class="trip-route">@booking.Trip?.DepartureFrom → @booking.Trip?.ArrivalTo</span>
                            </td>
                            <td class="cell-trip-name">@booking.Trip?.TripName</td>
                            <td class="cell-agency">@booking.AgencyName</td>
                            <td class="cell-hotel">@booking.HotelName</td>
                            <td class="cell-rooms">
                                <div class="rooms-stack">
                                    @if (booking.GroupCount > 0)
                                    {
                                        <span class="room-tag">ج @booking.GroupCount</span>
                                    }
                                    @if (booking.QuadrupleCount > 0)
                                    {
                                        <span class="room-tag">ر @booking.QuadrupleCount</span>
                                    }
                                    @if (booking.TripleCount > 0)
                                    {
                                        <span class="room-tag">ث @booking.TripleCount</span>
                                    }
                                    @if (booking.DoubleCount > 0)
                                    {
                                        <span class="room-tag">ن @booking.DoubleCount</span>
                                    }
                                    @if (booking.ChildCount > 0)
                                    {
                                        <span class="room-tag child">👶 @booking.ChildCount</span>
                                    }
                                    @if (booking.InfantCount > 0)
                                    {
                                        <span class="room-tag infant">🍼 @booking.InfantCount</span>
                                    }
                                </div>
                            </td>
                            <td class="cell-number">@booking.TotalPilgrims</td>
                            <td class="cell-amount">@booking.TotalAmount.ToString("N0")</td>
                            <td class="cell-amount discount" style="color:#e65100;">@booking.Reduction.ToString("N0")</td>
                            <td class="cell-amount commission">@booking.Commission.ToString("N0")</td>
                            <td class="cell-amount net">@booking.NetProfit.ToString("N0")</td>
                            <td class="cell-amount" style="color:#1565c0;">@booking.PaidAmount.ToString("N0")</td>
                            <td class="cell-amount" style="color:@(booking.RemainingAmount > 0 ? "#dc2626" : "#2e7d32");">@booking.RemainingAmount.ToString("N0")</td>
                            <td class="cell-actions">
                                <button class="table-action-btn print" title="طباعة" @onclick="() => PrintBookingReceipt(booking)">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="6 9 6 2 18 2 18 9"></polyline>
                                        <path d="M6 12H4a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-4a2 2 0 0 0-2-2h-2"></path>
                                        <rect x="6" y="14" width="12" height="8"></rect>
                                    </svg>
                                </button>
                                <button class="table-action-btn view" title="عرض" @onclick="() => ViewDetails(booking)">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                        <circle cx="12" cy="12" r="3"></circle>
                                    </svg>
                                </button>
                                <button class="table-action-btn payment" title="تسديد" @onclick="() => AddPayment(booking)">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <line x1="12" y1="1" x2="12" y2="23"></line>
                                        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                                    </svg>
                                </button>
                                <button class="table-action-btn edit" title="تعديل" @onclick="() => EditBooking(booking)">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                                    </svg>
                                </button>
                                <button class="table-action-btn delete" title="حذف" @onclick="() => ConfirmDeleteBooking(booking)">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="3 6 5 6 21 6"></polyline>
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                    </svg>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="no-results">
            <div class="no-results-icon">
                <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                    <rect x="3" y="3" width="18" height="18" rx="2" />
                    <line x1="3" y1="9" x2="21" y2="9" />
                    <line x1="9" y1="21" x2="9" y2="9" />
                    <circle cx="12" cy="15" r="1" fill="currentColor" />
                </svg>
            </div>
            <h3 class="no-results-title">لا توجد حجوزات</h3>
            <p class="no-results-text">لم يتم العثور على أي حجوزات تطابق معايير البحث</p>
        </div>
    }
</div>

<!-- Delete Confirmation -->
@if (showDeleteBookingDialog && bookingToDelete != null)
{
    <div class="modal-overlay" @onclick="CancelDeleteBooking">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="modal-header" style="background:#dc2626;">
                <h3 style="color:white;">تأكيد الحذف</h3>
                <button class="modal-close" style="color:white;" @onclick="CancelDeleteBooking">✕</button>
            </div>
            <div class="modal-body">
                <p>هل أنت متأكد من حذف حجز الوكالة <strong>@bookingToDelete.AgencyName</strong>؟</p>
                <div class="delete-trip-info">
                    <div class="info-row">
                        <span class="info-label">الرحلة:</span>
                        <span class="info-value">@bookingToDelete.Trip?.TripName</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">الفندق:</span>
                        <span class="info-value">@bookingToDelete.HotelName</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">المعتمرين:</span>
                        <span class="info-value">@bookingToDelete.TotalPilgrims</span>
                    </div>
                </div>

                <!-- Verification Code -->
                <div class="verification-box">
                    <p class="verification-text">أدخل رمز التأكيد للمتابعة:</p>
                    <div class="verification-code-display">@deleteVerificationCode</div>
                    <input type="text" class="form-input verification-input"
                           @bind="deleteCodeInput"
                           placeholder="أدخل الرمز المكون من 5 أرقام"
                           maxlength="5" />
                    @if (!string.IsNullOrEmpty(deleteCodeError))
                    {
                        <p class="verification-error">@deleteCodeError</p>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-cancel" @onclick="CancelDeleteBooking" disabled="@isDeletingBooking">إلغاء</button>
                <button class="btn-delete" @onclick="DeleteBookingConfirmed"
                        disabled="@(isDeletingBooking || deleteCodeInput != deleteVerificationCode)">
                    @if (isDeletingBooking)
                    {
                        <span class="spinner"></span><span>جاري الحذف...</span>
                    }
                    else
                    {

                        <span>🗑️ حذف</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@if (showPaymentModal && paymentBooking != null)
{
    <div class="modal-overlay" @onclick="() => { if (!isSavingPayment) showPaymentModal = false; }">
        <div class="modal-card" @onclick:stopPropagation="true" style="max-width:450px;">
            <div class="modal-header" style="background:#2e7d32;">
                <h3 style="color:white;">💵 تسديد حجز</h3>
                <button class="modal-close" style="color:white;"
                        @onclick="() => { if (!isSavingPayment) showPaymentModal = false; }">
                    ✕
                </button>
            </div>
            <div class="modal-body">
                <div class="payment-summary">
                    <div class="summary-row"><span>الوكالة:</span><strong>@paymentBooking.AgencyName</strong></div>
                    <div class="summary-row"><span>الرحلة:</span><strong>@paymentBooking.Trip?.TripNumber</strong></div>
                    <div class="summary-row"><span>المستحق:</span><strong style="color:#2e7d32;">@paymentBooking.NetProfit.ToString("N0") دج</strong></div>
                    <div class="summary-row"><span>المدفوع:</span><strong style="color:#1565c0;">@totalPaidForBooking.ToString("N0") دج</strong></div>
                    <div class="summary-row"><span>المتبقي:</span><strong style="color:#dc2626;">@remainingForBooking.ToString("N0") دج</strong></div>
                </div>

                <div class="form-group">
                    <label class="form-label">المبلغ *</label>
                    <input type="number" class="form-input @(paymentAmount > remainingForBooking ? "input-error" : "")"
                           @bind="paymentAmount" step="1000" min="1" />
                    @if (!string.IsNullOrEmpty(paymentError))
                    {
                        <p class="payment-error">@paymentError</p>
                    }
                    else if (paymentAmount > 0)
                    {
                        <p class="payment-info">المتبقي بعد الدفع: <strong>@((remainingForBooking - paymentAmount).ToString("N0")) دج</strong></p>
                    }
                </div>
                <div class="form-group">
                    <label class="form-label">طريقة الدفع</label>
                    <select class="form-input" @bind="paymentMethod">
                        <option value="نقداً">نقداً</option>
                        <option value="تحويل بنكي">تحويل بنكي</option>
                        <option value="شيك">شيك</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">ملاحظات</label>
                    <textarea class="form-input" @bind="paymentNotes" rows="2"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-cancel" @onclick="() => { if (!isSavingPayment) showPaymentModal = false; }">إلغاء</button>
                <button class="btn-save" @onclick="SavePayment"
                        disabled="@(isSavingPayment || paymentAmount <= 0 || paymentAmount > remainingForBooking)">
                    @if (isSavingPayment)
                    {
                        <span class="spinner"></span><span>جاري الحفظ...</span>
                    }
                    else
                    {
                        <span>💾 حفظ</span>
                    }
                </button>
            </div>
        </div>
    </div>
}



<!-- Edit Agency Booking Modal -->
@if (showEditBookingModal && editBookingModel != null)
{
    <div class="bkg-overlay" @onclick="CancelEditBooking">
        <div class="bkg-card bkg-agency-wide" @onclick:stopPropagation="true">
            <!-- Header -->
            <div class="bkg-header">
                <h3 class="bkg-title">✏️ تعديل حجز وكالة</h3>
                <button class="bkg-close" @onclick="CancelEditBooking" disabled="@isEditBookingSaving">✕</button>
            </div>

            <!-- Trip Summary -->
            <div class="bkg-summary">
                <div class="bkg-summary-row"><span class="bkg-summary-lbl">رقم الرحلة:</span><span class="bkg-summary-val">@editTripInfo?.TripNumber</span></div>
                <div class="bkg-summary-row"><span class="bkg-summary-lbl">التاريخ:</span><span class="bkg-summary-val">@editTripInfo?.DepartureDate.ToString("dd/MM/yyyy")</span></div>
                <div class="bkg-summary-row"><span class="bkg-summary-lbl">الخطوط:</span><span class="bkg-summary-val">@editTripInfo?.Airline</span></div>
                <div class="bkg-summary-row"><span class="bkg-summary-lbl">المقاعد المتبقية:</span><span class="bkg-summary-val">@editTripInfo?.RemainingSeats</span></div>
                <div class="bkg-route">✈ @editTripInfo?.DepartureFrom → @editTripInfo?.ArrivalTo</div>
            </div>

            <!-- Body - Two Columns -->
            <div class="bkg-body">
                <!-- Left Column -->
                <div class="bkg-col">
                    <!-- Hotel -->
                    <div class="bkg-field">
                        <label class="bkg-label">الفندق</label>
                        <div class="bkg-btns">
                            @foreach (var hotel in editHotelList)
                            {
                                <button class="bkg-btn @(editSelectedHotel == hotel ? "active" : "")"
                                        @onclick="() => SelectEditHotel(hotel)">
                                    @hotel
                                </button>
                            }
                        </div>
                        @if (editSelectedHotel == "أخرى")
                        {
                            <input type="text" class="bkg-input" @bind="editCustomHotel"
                                   placeholder="أدخل اسم الفندق" style="margin-top:0.5rem;" />
                        }
                    </div>

                    <!-- Room Type Distribution with Individual Prices -->
                    <div class="bkg-field">
                        <label class="bkg-label">توزيع المعتمرين والأسعار حسب نوع الغرفة</label>
                        <div class="bkg-room-dist">
                            <!-- جماعي -->
                            <div class="bkg-room-row">
                                <span class="bkg-room-type">جماعي</span>
                                <input type="number" class="bkg-input bkg-sm-input" @bind="editRoomCounts.Group" min="0" placeholder="0" />
                                <span>معتمر ×</span>
                                <input type="number" class="bkg-input bkg-price-input" @bind="editRoomPrices.GroupPrice" step="1000" min="0" placeholder="السعر" />
                                <span>دج</span>
                            </div>
                            <!-- رباعي -->
                            <div class="bkg-room-row">
                                <span class="bkg-room-type">رباعي</span>
                                <input type="number" class="bkg-input bkg-sm-input" @bind="editRoomCounts.Quadruple" min="0" placeholder="0" />
                                <span>معتمر ×</span>
                                <input type="number" class="bkg-input bkg-price-input" @bind="editRoomPrices.QuadruplePrice" step="1000" min="0" placeholder="السعر" />
                                <span>دج</span>
                            </div>
                            <!-- ثلاثي -->
                            <div class="bkg-room-row">
                                <span class="bkg-room-type">ثلاثي</span>
                                <input type="number" class="bkg-input bkg-sm-input" @bind="editRoomCounts.Triple" min="0" placeholder="0" />
                                <span>معتمر ×</span>
                                <input type="number" class="bkg-input bkg-price-input" @bind="editRoomPrices.TriplePrice" step="1000" min="0" placeholder="السعر" />
                                <span>دج</span>
                            </div>
                            <!-- ثنائي -->
                            <div class="bkg-room-row">
                                <span class="bkg-room-type">ثنائي</span>
                                <input type="number" class="bkg-input bkg-sm-input" @bind="editRoomCounts.Double" min="0" placeholder="0" />
                                <span>معتمر ×</span>
                                <input type="number" class="bkg-input bkg-price-input" @bind="editRoomPrices.DoublePrice" step="1000" min="0" placeholder="السعر" />
                                <span>دج</span>
                            </div>
                            <!-- طفل -->
                            <div class="bkg-room-row">
                                <span class="bkg-room-type">طفل</span>
                                <input type="number" class="bkg-input bkg-sm-input" @bind="editRoomCounts.Child" min="0" placeholder="0" />
                                <span>معتمر ×</span>
                                <input type="number" class="bkg-input bkg-price-input" @bind="editRoomPrices.ChildPrice" step="1000" min="0" placeholder="السعر" />
                                <span>دج</span>
                            </div>
                            <!-- رضيع -->
                            <div class="bkg-room-row">
                                <span class="bkg-room-type">رضيع</span>
                                <input type="number" class="bkg-input bkg-sm-input" @bind="editRoomCounts.Infant" min="0" placeholder="0" />
                                <span>معتمر ×</span>
                                <input type="number" class="bkg-input bkg-price-input" @bind="editRoomPrices.InfantPrice" step="1000" min="0" placeholder="السعر" />
                                <span>دج</span>
                            </div>
                        </div>
                        <div class="bkg-total-pilgrims">
                            <span>إجمالي المعتمرين:</span>
                            <strong>@(editRoomCounts.Group + editRoomCounts.Quadruple + editRoomCounts.Triple + editRoomCounts.Double + editRoomCounts.Child + editRoomCounts.Infant)</strong>
                        </div>
                    </div>
                </div>

                <!-- Right Column -->
                <div class="bkg-col">
                    <!-- Agency Selection -->
                    <div class="bkg-field">
                        <label class="bkg-label">الوكالة</label>
                        <select class="bkg-select" @bind="editSelectedAgency">
                            <option value="">اختر الوكالة...</option>
                            @foreach (var agency in agencies)
                            {
                                <option value="@agency.AgencyName">@agency.AgencyName</option>
                            }
                        </select>
                    </div>

                    <!-- Commission per adult -->
                    <div class="bkg-field bkg-currency">
                        <label class="bkg-label">عمولة الوكالة لكل معتمر (دج)</label>
                        <input type="number" class="bkg-input" @bind="editCommission" step="500" min="0" />
                        <span class="bkg-currency-sym">دج</span>
                    </div>

                    <!-- Custom Reduction -->
                    <div class="bkg-field bkg-currency">
                        <label class="bkg-label">تخفيض / خصم (دج)</label>
                        <input type="number" class="bkg-input" @bind="editReduction" step="500" min="0" />
                        <span class="bkg-currency-sym">دج</span>
                    </div>

                    <!-- Calculations -->
                    @{
                        var eGroupTotal = editRoomCounts.Group * editRoomPrices.GroupPrice;
                        var eQuadTotal = editRoomCounts.Quadruple * editRoomPrices.QuadruplePrice;
                        var eTripleTotal = editRoomCounts.Triple * editRoomPrices.TriplePrice;
                        var eDoubleTotal = editRoomCounts.Double * editRoomPrices.DoublePrice;
                        var eChildTotal = editRoomCounts.Child * editRoomPrices.ChildPrice;
                        var eInfantTotal = editRoomCounts.Infant * editRoomPrices.InfantPrice;
                        var eSubTotal = eGroupTotal + eQuadTotal + eTripleTotal + eDoubleTotal + eChildTotal + eInfantTotal;
                        var eTotalAmount = eSubTotal - editReduction;
                        if (eTotalAmount < 0) eTotalAmount = 0;
                        var eAdultPilgrims = editRoomCounts.Group + editRoomCounts.Quadruple + editRoomCounts.Triple + editRoomCounts.Double;
                        var eTotalCommission = editCommission * eAdultPilgrims;
                        var eNetProfit = eTotalAmount - eTotalCommission;
                    }

                    <!-- Total Amount -->
                    <div class="bkg-total">
                        <span>المبلغ الإجمالي</span>
                        <span class="bkg-total-val">@eTotalAmount.ToString("N0") دج</span>
                    </div>

                    <!-- Net Profit -->
                    <div class="bkg-profit">
                        <span class="bkg-profit-lbl">الربح الصافي</span>
                        <span class="bkg-profit-val">@eNetProfit.ToString("N0") دج</span>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="bkg-footer">
                <button class="bkg-btn-cancel" @onclick="CancelEditBooking" disabled="@isEditBookingSaving">
                    ✕ إلغاء
                </button>
                <button class="bkg-btn-save" @onclick="SaveEditBooking" disabled="@isEditBookingSaving">
                    @if (isEditBookingSaving)
                    {
                        <span class="bkg-spinner"></span>
                        <span>جاري الحفظ...</span>
                    }
                    else
                    {
                        <span>💾 حفظ التعديلات</span>
                    }
                </button>
            </div>
        </div>
    </div>
}



