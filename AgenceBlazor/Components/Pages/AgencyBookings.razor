    // Delete booking
    private bool showDeleteBookingDialog = false;
    private AgencyBooking bookingToDelete = null;
    private bool isDeletingBooking = false;
    private string deleteVerificationCode = "";
    private string deleteCodeInput = "";
    private string deleteCodeError = "";

    private void ConfirmDeleteBooking(AgencyBooking booking)
    {
        bookingToDelete = booking;
        deleteVerificationCode = new Random().Next(10000, 99999).ToString();
        deleteCodeInput = "";
        deleteCodeError = "";
        showDeleteBookingDialog = true;
    }

    private void CancelDeleteBooking()
    {
        if (!isDeletingBooking)
        {
            showDeleteBookingDialog = false;
            bookingToDelete = null;
            deleteCodeInput = "";
            deleteVerificationCode = "";
            deleteCodeError = "";
        }
    }

    private async Task DeleteBookingConfirmed()
    {
        if (bookingToDelete == null) return;

        if (deleteCodeInput != deleteVerificationCode)
        {
            deleteCodeError = "الرمز غير صحيح، حاول مرة أخرى";
            return;
        }

        try
        {
            isDeletingBooking = true;
            deleteCodeError = "";
            StateHasChanged();

            var success = await AgencyBookingService.DeleteAsync(bookingToDelete.Id);
            if (success)
            {
                showDeleteBookingDialog = false;
                bookingToDelete = null;
                deleteCodeInput = "";
                deleteVerificationCode = "";
                await LoadDataAsync();
            }
        }
        catch { }
        finally { isDeletingBooking = false; StateHasChanged(); }
    }

    // Edit booking variables
    private bool showEditBookingModal = false;
    private AgencyBooking? editBookingModel = null;
    private bool isEditBookingSaving = false;
    private Trip? editTripInfo = null;
    private string editSelectedAgency = "";
    private string editSelectedHotel = "";
    private string editCustomHotel = "";
    private decimal editCommission = 5000;
    private decimal editReduction = 0;
    private List<string> editHotelList = new();
    private EditRoomCounts editRoomCounts = new();
    private EditRoomPrices editRoomPrices = new();

    private class EditRoomCounts
    {
        public int Group { get; set; }
        public int Quadruple { get; set; }
        public int Triple { get; set; }
        public int Double { get; set; }
        public int Child { get; set; }
        public int Infant { get; set; }
    }

    private class EditRoomPrices
    {
        public decimal GroupPrice { get; set; }
        public decimal QuadruplePrice { get; set; }
        public decimal TriplePrice { get; set; }
        public decimal DoublePrice { get; set; }
        public decimal ChildPrice { get; set; }
        public decimal InfantPrice { get; set; }
    }
