@page "/direct-pilgrims"
@rendermode InteractiveServer
@using System.Globalization
@using AgenceBlazor.Models
@using AgenceBlazor.Services
@inject DirectPilgrimService DirectPilgrimService
@inject TripService TripService
@inject AgencyService AgencyService
@inject PaymentService PaymentService
@inject AgencyBookingService AgencyBookingService

<div class="pilgrims-container">
    <!-- Header -->
    <div class="page-header">
        <div class="header-content">
            <div class="header-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                    <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
            </div>
            <div>
                <h1 class="page-title">المعتمرون المباشرون</h1>
                <p class="page-subtitle">تسجيلات المعتمرين المباشرة من المكتب</p>
            </div>
        </div>
        <div class="header-stats">
            <div class="stat-item">
                <span class="stat-value">@allPilgrims.Count</span>
                <span class="stat-label">تسجيل</span>
            </div>
            <div class="stat-item">
                <span class="stat-value">@allPilgrims.Sum(p => p.TotalPilgrims)</span>
                <span class="stat-label">معتمر</span>
            </div>
            <div class="stat-item">
                <span class="stat-value">@allPilgrims.Sum(p => p.NetAmount).ToString("N0")</span>
                <span class="stat-label">المبلغ الإجمالي</span>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="filters-section">
        <div class="filters-container">
            <div class="search-wrapper">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="2">
                    <circle cx="11" cy="11" r="8" /><path d="M21 21l-4.35-4.35" />
                </svg>
                <input type="text" class="search-input" placeholder="ابحث عن معتمر..." @bind="searchQuery" @bind:event="oninput" />
            </div>
            <select class="filter-select" @bind="filterTripId" @bind:event="onchange">
                <option value="0">جميع الرحلات</option>
                @foreach (var trip in trips)
                {
                    <option value="@trip.Id">@trip.TripNumber - @trip.TripName</option>
                }
            </select>
            <div class="view-toggle">
                <button class="view-btn @(viewMode == "cards" ? "active" : "")" @onclick="SwitchToCards" title="عرض بطاقات">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="7" height="7" />
                        <rect x="14" y="3" width="7" height="7" />
                        <rect x="3" y="14" width="7" height="7" />
                        <rect x="14" y="14" width="7" height="7" />
                    </svg>
                </button>
                <button class="view-btn @(viewMode == "table" ? "active" : "")" @onclick="SwitchToTable" title="عرض جدول">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="8" y1="6" x2="21" y2="6" />
                        <line x1="8" y1="12" x2="21" y2="12" />
                        <line x1="8" y1="18" x2="21" y2="18" />
                        <line x1="3" y1="6" x2="3.01" y2="6" />
                        <line x1="3" y1="12" x2="3.01" y2="12" />
                        <line x1="3" y1="18" x2="3.01" y2="18" />
                    </svg>
                </button>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading-container"><div class="loading-spinner"></div><p>جاري التحميل...</p></div>
    }
    else if (filteredPilgrims.Any())
    {
        @if (viewMode == "cards")
        {
            <!-- Cards View -->
            <div class="pilgrims-grid">
                @foreach (var pilgrim in filteredPilgrims)
                {
                    <div class="pilgrim-card">
                        <div class="card-accent"></div>
                        <div class="card-body">
                            <div class="pilgrim-header">
                                <div class="pilgrim-avatar">
                                    @(pilgrim.MainPilgrimName?.Length >= 1 ? pilgrim.MainPilgrimName.Substring(0, 1) : "م")
                                </div>
                                <div class="pilgrim-info">
                                    <h3 class="pilgrim-name">@pilgrim.MainPilgrimName</h3>
                                    @if (!string.IsNullOrEmpty(pilgrim.MainPilgrimPhone))
                                    {
                                        <span class="pilgrim-phone" dir="ltr">📞 @pilgrim.MainPilgrimPhone</span>
                                    }
                                </div>
                                <span class="trip-badge">@GetTripNumber(pilgrim.TripId)</span>
                            </div>

                            <div class="card-details">
                                <div class="detail-item">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M19 21V5a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v16" /><path d="M3 21h18" />
                                    </svg>
                                    <span>@pilgrim.HotelName</span>
                                </div>
                                <div class="detail-item">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                                        <circle cx="9" cy="7" r="4" />
                                    </svg>
                                    <span>@pilgrim.TotalPilgrims معتمر</span>
                                </div>
                                <div class="detail-item">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="4" width="18" height="18" rx="2" />
                                        <line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" />
                                    </svg>
                                    <span>@pilgrim.CreatedAt.ToString("dd/MM/yyyy")</span>
                                </div>
                            </div>

                            @if (pilgrim.FamilyMembers.Any())
                            {
                                <div class="family-section">
                                    <span class="family-label">👨‍👩‍👧‍👦 أفراد العائلة:</span>
                                    <div class="family-tags">
                                        @foreach (var member in pilgrim.FamilyMembers.Take(4))
                                        {
                                            <span class="family-tag" title="@member.RoomType">@member.Name</span>
                                        }
                                        @if (pilgrim.FamilyMembers.Count > 4)
                                        {
                                            <span class="family-tag more">+@(pilgrim.FamilyMembers.Count - 4)</span>
                                        }
                                    </div>
                                </div>
                            }

                            <div class="card-financials">
                                <div class="financial-row">
                                    <span>المبلغ:</span>
                                    <span class="amount">@pilgrim.TotalAmount.ToString("N0") دج</span>
                                </div>
                                @if (pilgrim.Discount > 0)
                                {
                                    <div class="financial-row discount">
                                        <span>تخفيض:</span>
                                        <span>-@pilgrim.Discount.ToString("N0") دج</span>
                                    </div>
                                }
                                <div class="financial-row net">
                                    <span>الصافي:</span>
                                    <span class="net-amount">@pilgrim.NetAmount.ToString("N0") دج</span>
                                </div>
                                <div class="financial-row paid">
                                    <span>المدفوع:</span>
                                    <span class="paid-amount @(pilgrim.PaidAmount > 0 ? "has-payment" : "")">@pilgrim.PaidAmount.ToString("N0") دج</span>
                                </div>
                                <div class="financial-row remaining @(pilgrim.RemainingAmount == 0 ? "fully-paid" : "")">
                                    <span>@(pilgrim.RemainingAmount == 0 ? "✅ مكتمل" : "المتبقي:")</span>
                                    <span class="remaining-amount @(pilgrim.RemainingAmount == 0 ? "zero" : "")">
                                        @(pilgrim.RemainingAmount == 0 ? "بالكامل" : pilgrim.RemainingAmount.ToString("N0") + " دج")
                                    </span>
                                </div>

                                <!-- Progress bar -->
                                @if (pilgrim.NetAmount > 0)
                                {
                                    var payPercent = (int)(pilgrim.PaidAmount / pilgrim.NetAmount * 100);
                                    <div class="payment-progress">
                                        <div class="progress-bar">
                                            <div class="progress-fill @(payPercent >= 100 ? "complete" : "")"
                                                 style="width:@payPercent%"></div>
                                        </div>
                                        <span class="progress-text">@payPercent%</span>
                                    </div>
                                }
                            </div>
                            <td>
                                <span class="status-badge @(pilgrim.NetAmount <= 0 ? "paid" : "pending")">
                                    @(pilgrim.NetAmount <= 0 ? "مدفوع" : "معلق")
                                </span>
                            </td>

                            <div class="card-actions">
                                <button class="card-btn details-btn" @onclick="() => ShowDetails(pilgrim)">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10" />
                                        <path d="M12 16v-4" />
                                        <path d="M12 8h.01" />
                                    </svg>
                                    تفاصيل
                                </button>
                                <button class="card-btn pay-btn" @onclick="() => OpenPaymentModal(pilgrim)" title="تسديد">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <line x1="12" y1="1" x2="12" y2="23" />
                                        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                                    </svg>
                                    تسديد
                                </button>
                                <button class="card-btn delete-btn" @onclick="() => ConfirmDelete(pilgrim)" title="حذف">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="3 6 5 6 21 6" />
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                                    </svg>
                                    حذف
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <!-- Table View -->
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>المعتمر الرئيسي</th>
                            <th>الهاتف</th>
                            <th>الرحلة</th>
                            <th>الفندق</th>
                            <th>الغرفة</th>
                            <th>العدد</th>
                            <th>المبلغ</th>
                            <th>تخفيض</th>
                            <th>الصافي</th>
                            <th>المدفوع</th>
                            <th>المتبقي</th>
                            <th>الحالة</th>
                            <th>التاريخ</th>
                            <th>إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pilgrim in filteredPilgrims)
                        {
                            <tr>
                                <td>@pilgrim.Id</td>
                                <td class="name-cell">
                                    <div class="name-avatar">@(pilgrim.MainPilgrimName?.Length >= 1 ? pilgrim.MainPilgrimName.Substring(0, 1) : "م")</div>
                                    <span>@pilgrim.MainPilgrimName</span>
                                </td>
                                <td dir="ltr">@pilgrim.MainPilgrimPhone</td>
                                <td><span class="trip-badge">@GetTripNumber(pilgrim.TripId)</span></td>
                                <td>@pilgrim.HotelName</td>
                                <td>@pilgrim.MainPilgrimRoomType</td>
                                <td>@pilgrim.TotalPilgrims</td>
                                <td class="amount-cell">@pilgrim.TotalAmount.ToString("N0")</td>
                                <td class="discount-cell">@(pilgrim.Discount > 0 ? pilgrim.Discount.ToString("N0") : "-")</td>
                                <td class="net-cell">@pilgrim.NetAmount.ToString("N0")</td>
                                <td class="paid-cell">@pilgrim.PaidAmount.ToString("N0")</td>
                                <td class="remaining-cell @(pilgrim.RemainingAmount == 0 ? "zero" : "")">
                                    @(pilgrim.RemainingAmount == 0 ? "✅" : pilgrim.RemainingAmount.ToString("N0"))
                                </td>
                                <td>
                                    @if (pilgrim.RemainingAmount == 0)
                                    {
                                        <span class="status-badge paid">مكتمل</span>
                                    }
                                    else if (pilgrim.PaidAmount > 0)
                                    {
                                        <span class="status-badge partial">جزئي</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge pending">معلق</span>
                                    }
                                </td>
                                <td>@pilgrim.CreatedAt.ToString("dd/MM/yyyy")</td>
                                @* <td>
                                    <button class="action-btn details" @onclick="() => ShowDetails(pilgrim)" title="تفاصيل">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <circle cx="12" cy="12" r="10" /><path d="M12 16v-4" /><path d="M12 8h.01" />
                                        </svg>
                                    </button>
                                </td> *@
                                <td>
                                    <div class="action-buttons">
                                        <button class="action-btn details" @onclick="() => ShowDetails(pilgrim)" title="تفاصيل">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <circle cx="12" cy="12" r="10" />
                                                <path d="M12 16v-4" />
                                                <path d="M12 8h.01" />
                                            </svg>
                                        </button>
                                        <button class="action-btn pay" @onclick="() => OpenPaymentModal(pilgrim)" title="تسديد">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <line x1="12" y1="1" x2="12" y2="23" />
                                                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                                            </svg>
                                        </button>
                                        <button class="action-btn delete" @onclick="() => ConfirmDelete(pilgrim)" title="حذف">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <polyline points="3 6 5 6 21 6" />
                                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                                            </svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
    else
    {
        <div class="no-results">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#d1d5db" stroke-width="1.5">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
            </svg>
            <h3>لا توجد تسجيلات</h3>
        </div>
    }
</div>
<!-- Payment Modal -->
@if (showPaymentModal && paymentPilgrim != null)
{
    <div class="modal-overlay" @onclick="ClosePaymentModal">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="modal-header" style="background: #1b5e20;">
                <h3>💳 تسديد دفعة</h3>
                <button class="modal-close" @onclick="ClosePaymentModal">✕</button>
            </div>
            <div class="modal-body">
                <div class="payment-summary">
                    <div class="payment-info-row">
                        <span>المعتمر:</span>
                        <strong>@paymentPilgrim.MainPilgrimName</strong>
                    </div>
                    <div class="payment-info-row">
                        <span>المبلغ المستحق:</span>
                        <strong>@paymentPilgrim.NetAmount.ToString("N0") دج</strong>
                    </div>
                    <div class="payment-info-row">
                        <span>المدفوع سابقاً:</span>
                        <strong style="color:#16a34a;">@paymentPilgrim.PaidAmount.ToString("N0") دج</strong>
                    </div>
                    <div class="payment-info-row">
                        <span>المتبقي:</span>
                        <strong style="color:#dc2626;">@paymentPilgrim.RemainingAmount.ToString("N0") دج</strong>
                    </div>
                </div>

                <div class="form-group">
                    <label>المبلغ المدفوع (دج)</label>
                    <input type="number" class="form-input" @bind="paymentAmount" step="1000" min="0" max="@paymentPilgrim.RemainingAmount" />
                </div>

                <div class="form-group">
                    <label>طريقة الدفع</label>
                    <div class="payment-methods">
                        @foreach (var method in new[] { "نقداً", "شيك", "تحويل بنكي" })
                        {
                            <button class="method-btn @(paymentMethod == method ? "active" : "")"
                                    @onclick="() => paymentMethod = method">
                                @method
                            </button>
                        }
                    </div>
                </div>

                <div class="form-group">
                    <label>ملاحظات</label>
                    <input type="text" class="form-input" @bind="paymentNotes" placeholder="ملاحظات (اختياري)" />
                </div>

                <div class="payment-new-remaining">
                    <span>المتبقي بعد الدفع:</span>
                    <strong>@((paymentPilgrim.RemainingAmount - paymentAmount).ToString("N0")) دج</strong>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-cancel" @onclick="ClosePaymentModal" disabled="@isSavingPayment">إلغاء</button>
                <button class="btn-save" @onclick="SavePayment"
                        disabled="@(isSavingPayment || paymentAmount <= 0 || paymentAmount > paymentPilgrim.RemainingAmount)">
                    @if (isSavingPayment)
                    {
                        <span>جاري الحفظ...</span>
                    }
                    else
                    {
                        <span>💾 تأكيد الدفع</span>
                    }
                </button>
            </div>
        </div>
    </div>
}
<!-- Details Modal -->
@if (showDetailsModal && selectedPilgrim != null)
{
    <div class="modal-overlay" @onclick="CloseDetails">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="modal-header" style="background: #1b5e20;">
                <h3>تفاصيل التسجيل</h3>
                <button class="modal-close" @onclick="CloseDetails">✕</button>
            </div>
            <div class="modal-body">
                <div class="detail-section">
                    <h4>👤 المعتمر الرئيسي</h4>
                    <div class="info-grid">
                        <div class="info-item"><span>الاسم:</span><strong>@selectedPilgrim.MainPilgrimName</strong></div>
                        <div class="info-item"><span>الهاتف:</span><strong dir="ltr">@selectedPilgrim.MainPilgrimPhone</strong></div>
                        <div class="info-item"><span>العنوان:</span><strong>@selectedPilgrim.MainPilgrimAddress</strong></div>
                        <div class="info-item"><span>نوع الغرفة:</span><strong>@selectedPilgrim.MainPilgrimRoomType</strong></div>
                    </div>
                </div>

                @if (selectedPilgrim.FamilyMembers.Any())
                {
                    <div class="detail-section">
                        <h4>👨‍👩‍👧‍👦 أفراد العائلة (@selectedPilgrim.FamilyMembers.Count)</h4>
                        <div class="family-list">
                            @foreach (var member in selectedPilgrim.FamilyMembers)
                            {
                                <div class="family-list-item">
                                    <span class="family-list-name">@member.Name</span>
                                    <span class="family-list-relation">@member.Relation</span>
                                    <span class="family-list-room">@member.RoomType</span>
                                </div>
                            }
                        </div>
                    </div>
                }

                <div class="detail-section">
                    <h4>💰 الملخص المالي</h4>
                    <div class="financial-summary">
                        <div class="fin-row"><span>المبلغ الإجمالي:</span><span>@selectedPilgrim.TotalAmount.ToString("N0") دج</span></div>
                        @if (selectedPilgrim.Discount > 0)
                        {
                            <div class="fin-row discount"><span>تخفيض:</span><span>-@selectedPilgrim.Discount.ToString("N0") دج</span></div>
                        }
                        <div class="fin-row net"><span>المبلغ الصافي:</span><span>@selectedPilgrim.NetAmount.ToString("N0") دج</span></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-cancel" @onclick="CloseDetails">إغلاق</button>
            </div>
        </div>
    </div>
}


<!-- Delete Confirmation Modal -->
@if (showDeleteConfirm && pilgrimToDelete != null)
{
    <div class="modal-overlay" @onclick="CancelDelete">
        <div class="modal-card delete-modal" @onclick:stopPropagation="true">
            <div class="modal-header" style="background: #dc2626;">
                <h3>⚠️ تأكيد الحذف</h3>
                <button class="modal-close" @onclick="CancelDelete">✕</button>
            </div>
            <div class="modal-body">
                <div class="delete-warning">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="1.5">
                        <circle cx="12" cy="12" r="10" />
                        <line x1="12" y1="8" x2="12" y2="12" />
                        <line x1="12" y1="16" x2="12.01" y2="16" />
                    </svg>
                    <p>هل أنت متأكد من حذف تسجيل المعتمر؟</p>
                    <div class="pilgrim-delete-info">
                        <strong>@pilgrimToDelete.MainPilgrimName</strong>
                        @if (pilgrimToDelete.FamilyMembers.Any())
                        {
                            <span>+ @pilgrimToDelete.FamilyMembers.Count من أفراد العائلة</span>
                        }
                        <span class="delete-amount">@pilgrimToDelete.NetAmount.ToString("N0") دج</span>
                    </div>
                    <p class="delete-note">لا يمكن التراجع عن هذا الإجراء</p>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-cancel" @onclick="CancelDelete" disabled="@isDeleting">إلغاء</button>
                <button class="btn-delete" @onclick="DeletePilgrim" disabled="@isDeleting">
                    @if (isDeleting)
                    {
                        <span>جاري الحذف...</span>
                    }
                    else
                    {
                        <span>🗑️ تأكيد الحذف</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<DirectPilgrim> allPilgrims = new();
    private List<DirectPilgrim> filteredPilgrims = new();
    private List<Trip> trips = new();
    private bool isLoading = true;
    private string viewMode = "table";
    private bool showDetailsModal = false;
    private DirectPilgrim? selectedPilgrim = null;

    // Use properties with auto-filter
    private string _searchQuery = "";
    private string searchQuery
    {
        get => _searchQuery;
        set { _searchQuery = value; ApplyFilters(); StateHasChanged(); }
    }

    private int _filterTripId = 0;
    private int filterTripId
    {
        get => _filterTripId;
        set { _filterTripId = value; ApplyFilters(); StateHasChanged(); }
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            trips = await TripService.GetAllTripsAsync();
            allPilgrims = new List<DirectPilgrim>();
            foreach (var trip in trips)
            {
                var pilgrims = await DirectPilgrimService.GetByTripIdAsync(trip.Id);
                allPilgrims.AddRange(pilgrims);
            }
            allPilgrims = allPilgrims.OrderByDescending(p => p.CreatedAt).ToList();
            ApplyFilters();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SwitchToCards() => viewMode = "cards";
    private void SwitchToTable() => viewMode = "table";

    private void ApplyFilters()
    {
        var query = allPilgrims.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            var q = _searchQuery.ToLower();
            query = query.Where(p =>
                (p.MainPilgrimName?.ToLower().Contains(q) ?? false) ||
                (p.MainPilgrimPhone?.Contains(q) ?? false) ||
                p.FamilyMembers.Any(f => f.Name?.ToLower().Contains(q) ?? false));
        }

        if (_filterTripId > 0)
            query = query.Where(p => p.TripId == _filterTripId);

        filteredPilgrims = query.ToList();
    }

    private string GetTripNumber(int tripId)
    {
        return trips.FirstOrDefault(t => t.Id == tripId)?.TripNumber ?? "-";
    }

    private void ShowDetails(DirectPilgrim pilgrim)
    {
        selectedPilgrim = pilgrim;
        showDetailsModal = true;
    }

    private void CloseDetails()
    {
        showDetailsModal = false;
        selectedPilgrim = null;
    }

