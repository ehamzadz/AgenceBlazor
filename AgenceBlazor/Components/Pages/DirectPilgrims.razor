    protected override async Task OnInitializedAsync()
    {
        await LoadLocalAgency();
        await LoadData();
    }

    private async Task LoadLocalAgency()
    {
        try
        {
            var agencies = await AgencyService.GetAllAgenciesAdminAsync();
            localAgency = agencies.FirstOrDefault(a => a.AgencyName == "الوكالة المحلية");
        }
        catch { }
    }

    // Payment methods
    private void OpenPaymentModal(DirectPilgrim pilgrim)
    {
        paymentPilgrim = pilgrim;
        paymentAmount = pilgrim.RemainingAmount; // Default to full amount
        paymentMethod = "نقداً";
        paymentNotes = "";
        showPaymentModal = true;
    }

    private void ClosePaymentModal()
    {
        if (!isSavingPayment)
        {
            showPaymentModal = false;
            paymentPilgrim = null;
        }
    }

