    @inject AgencyBookingService AgencyBookingService  // Add this at the top

    private async Task SavePayment()
    {
        if (paymentPilgrim == null || paymentAmount <= 0) return;

        try
        {
            isSavingPayment = true;
            StateHasChanged();

            if (localAgency != null)
            {
                var allBookings = await AgencyBookingService.GetAllAsync();
                var matchingBooking = allBookings.FirstOrDefault(b => b.DirectPilgrimId == paymentPilgrim.Id);

                if (matchingBooking != null)
                {
                    var payment = new Payment
                    {
                        AgencyId = localAgency.AgencyId,
                        BookingId = matchingBooking.Id,
                        Amount = paymentAmount,
                        PaymentMethod = paymentMethod,
                        PaymentDate = DateTime.UtcNow,
                        Notes = paymentNotes ?? $"تسديد معتمر: {paymentPilgrim.MainPilgrimName}",
                        CreatedAt = DateTime.UtcNow,
                        UpdatedAt = DateTime.UtcNow
                    };

                    await PaymentService.CreateAsync(payment);
                    // Trigger handles: agencies.paidamount, agency_bookings.paid_amount, direct_pilgrims.paid_amount
                }
            }

            showPaymentModal = false;
            paymentPilgrim = null;
            await LoadLocalAgency();
            await LoadData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Payment error: {ex.Message}");
        }
        finally
        {
            isSavingPayment = false;
            StateHasChanged();
        }
    }


    // Add these variables at the top of @code block
    private bool showDeleteConfirm = false;
    private DirectPilgrim? pilgrimToDelete = null;
    private bool isDeleting = false;

    // Add these methods
    private void ConfirmDelete(DirectPilgrim pilgrim)
    {
        pilgrimToDelete = pilgrim;
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        showDeleteConfirm = false;
        pilgrimToDelete = null;
    }

    private async Task DeletePilgrim()
    {
        if (pilgrimToDelete == null) return;

        try
        {
            isDeleting = true;
            StateHasChanged();

            await DirectPilgrimService.DeleteAsync(pilgrimToDelete.Id);

            showDeleteConfirm = false;
            pilgrimToDelete = null;
            await LoadData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Delete error: {ex.Message}");
        }
        finally
        {
            isDeleting = false;
            StateHasChanged();
        }
    }
