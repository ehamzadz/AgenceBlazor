@page "/addtrips"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using AgenceBlazor.Models
@using AgenceBlazor.Services
@inject TripService TripService
@inject NavigationManager Navigation

<div class="add-trip-container">
    <div class="page-header">
        <div class="header-content">
            <div class="header-icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                    <path d="M12 5v14"></path>
                    <path d="M5 12h14"></path>
                </svg>
            </div>
            <div>
                <h1 class="page-title">إضافة رحلة جديدة</h1>
                <p class="page-subtitle">قم بإدخال بيانات الرحلة الجديدة</p>
            </div>
        </div>
    </div>

    <div class="form-card">
        <div class="form-accent"></div>
        <div class="form-body">
            <EditForm Model="@newTrip" OnValidSubmit="@HandleValidSubmit" class="trip-form">
                <DataAnnotationsValidator />

                <div class="form-grid">
                    <!-- اسم الرحلة -->
                    <div class="form-group full-width">
                        <label class="form-label" for="tripName">اسم الرحلة</label>
                        <InputText id="tripName"
                                   @bind-Value="newTrip.TripName"
                                   class="form-input"
                                   placeholder="أدخل اسم الرحلة" />
                        <ValidationMessage For="@(() => newTrip.TripName)" class="validation-message" />
                    </div>

                    <!-- رقم الرحلة -->
                    <div class="form-group">
                        <label class="form-label" for="tripNumber">رقم الرحلة</label>
                        <InputText id="tripNumber"
                                   @bind-Value="newTrip.TripNumber"
                                   class="form-input"
                                   placeholder="مثال: TR-2024-001" />
                        <ValidationMessage For="@(() => newTrip.TripNumber)" class="validation-message" />
                    </div>

                    <!-- تاريخ الانطلاق -->
                    <div class="form-group">
                        <label class="form-label" for="departureDate">تاريخ الانطلاق</label>
                        <InputDate id="departureDate"
                                   @bind-Value="newTrip.DepartureDate"
                                   class="form-input" />
                        <ValidationMessage For="@(() => newTrip.DepartureDate)" class="validation-message" />
                    </div>

                    <!-- نوع الرحلة -->
                    <div class="form-group">
                        <label class="form-label" for="tripType">نوع الرحلة</label>
                        <InputSelect id="tripType"
                                     @bind-Value="newTrip.TripType"
                                     class="form-input form-select">
                            <option value="">اختر نوع الرحلة</option>
                            <option value="مباشرة">مباشرة</option>
                            <option value="غير مباشرة">غير مباشرة</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => newTrip.TripType)" class="validation-message" />
                    </div>

                    <!-- الخطوط الجوية -->
                    <div class="form-group">
                        <label class="form-label" for="airline">الخطوط الجوية</label>
                        <InputSelect id="airline"
                                     @bind-Value="newTrip.Airline"
                                     class="form-input form-select">
                            <option value="">اختر الخطوط الجوية</option>
                            <option value="السعودية">السعودية</option>
                            <option value="التركية">التركية</option>
                            <option value="القطرية">القطرية</option>
                            <option value="الإماراتية">الإماراتية</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => newTrip.Airline)" class="validation-message" />
                    </div>

                    <!-- الانطلاق من -->
                    <div class="form-group">
                        <label class="form-label" for="departureFrom">الانطلاق من</label>
                        <InputText id="departureFrom"
                                   @bind-Value="newTrip.DepartureFrom"
                                   class="form-input"
                                   placeholder="مدينة الانطلاق" />
                        <ValidationMessage For="@(() => newTrip.DepartureFrom)" class="validation-message" />
                    </div>

                    <!-- الوصول إلى -->
                    <div class="form-group">
                        <label class="form-label" for="arrivalTo">الوصول إلى</label>
                        <InputText id="arrivalTo"
                                   @bind-Value="newTrip.ArrivalTo"
                                   class="form-input"
                                   placeholder="مدينة الوصول" />
                        <ValidationMessage For="@(() => newTrip.ArrivalTo)" class="validation-message" />
                    </div>

                    <!-- عدد المقاعد الإجمالي -->
                    <div class="form-group">
                        <label class="form-label" for="totalSeats">عدد المقاعد الإجمالي</label>
                        <InputNumber id="totalSeats"
                                     @bind-Value="newTrip.TotalSeats"
                                     class="form-input"
                                     placeholder="0"
                                     min="1" />
                        <ValidationMessage For="@(() => newTrip.TotalSeats)" class="validation-message" />
                    </div>

                    <!-- برنامج الرحلة -->
                    <div class="form-group full-width">
                        <label class="form-label" for="program">برنامج الرحلة</label>
                        <InputTextArea id="program"
                                       @bind-Value="newTrip.Program"
                                       class="form-input form-textarea"
                                       placeholder="مثال: دخول مدينة - خروج جدة"
                                       rows="3" />
                    </div>
                </div>

                <div class="form-actions">
                    <span class="action-hint">تأكد من صحة البيانات قبل الإضافة</span>
                    <div class="buttons-group">
                        <button type="button" class="btn-cancel" @onclick="ResetForm" disabled="@isSaving">إلغاء</button>
                        <button type="submit" class="btn-submit" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner"></span>
                                <span>جاري الحفظ...</span>
                            }
                            else
                            {
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M12 5v14"></path>
                                    <path d="M5 12h14"></path>
                                </svg>
                                <span>إضافة الرحلة</span>
                            }
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>

    @if (showSuccessMessage)
    {
        <div class="success-overlay" @onclick="CloseSuccess">
            <div class="success-card" @onclick:stopPropagation="true">
                <div class="success-icon">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                </div>
                <h3 class="success-title">تمت الإضافة بنجاح</h3>
                <p class="success-text">تم إضافة الرحلة "@lastAddedTripName" بنجاح</p>
                <button class="btn-close" @onclick="GoToTrips">عرض الرحلات</button>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-overlay" @onclick="ClearError">
            <div class="error-card" @onclick:stopPropagation="true">
                <div class="error-icon">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="15" y1="9" x2="9" y2="15"></line>
                        <line x1="9" y1="9" x2="15" y2="15"></line>
                    </svg>
                </div>
                <h3 class="error-title">خطأ</h3>
                <p class="error-text">@errorMessage</p>
                <button class="btn-close" @onclick="ClearError">حسناً</button>
            </div>
        </div>
    }
</div>

@code {
    private TripModel newTrip = new TripModel
    {
        DepartureDate = DateTime.Today.AddDays(7),
        TotalSeats = 100
    };

    private bool showSuccessMessage = false;
    private string lastAddedTripName = "";
    private bool isSaving = false;
    private string errorMessage = "";

    private async Task HandleValidSubmit()
    {
        isSaving = true;

        try
        {
            var trip = new Trip
            {
                TripName = newTrip.TripName,
                TripNumber = newTrip.TripNumber,
                DepartureDate = newTrip.DepartureDate,
                TripType = newTrip.TripType,
                Airline = newTrip.Airline,
                DepartureFrom = newTrip.DepartureFrom,
                ArrivalTo = newTrip.ArrivalTo,
                TotalSeats = newTrip.TotalSeats,
                FilledSeats = 0,
                Program = newTrip.Program,
                IsActive = true,
                CreatedAt = DateTime.UtcNow,
                UpdatedAt = DateTime.UtcNow
            };

            var success = await TripService.CreateAsync(trip);

            if (success)
            {
                lastAddedTripName = newTrip.TripName;
                showSuccessMessage = true;
                ResetForm();
            }
            else
            {
                errorMessage = "فشل في إضافة الرحلة. الرجاء المحاولة مرة أخرى.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"حدث خطأ: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ResetForm()
    {
        newTrip = new TripModel
        {
            DepartureDate = DateTime.Today.AddDays(7),
            TotalSeats = 100
        };
    }

    private void CloseSuccess()
    {
        showSuccessMessage = false;
    }

    private void GoToTrips()
    {
        showSuccessMessage = false;
        Navigation.NavigateTo("/tripsgallery");
    }

    private void ClearError()
    {
        errorMessage = "";
    }

    private class TripModel
    {
        [Required(ErrorMessage = "اسم الرحلة مطلوب")]
        public string TripName { get; set; } = "";

        [Required(ErrorMessage = "رقم الرحلة مطلوب")]
        public string TripNumber { get; set; } = "";

        [Required(ErrorMessage = "تاريخ الانطلاق مطلوب")]
        public DateTime DepartureDate { get; set; }

        [Required(ErrorMessage = "نوع الرحلة مطلوب")]
        public string TripType { get; set; } = "";

        [Required(ErrorMessage = "الخطوط الجوية مطلوبة")]
        public string Airline { get; set; } = "";

        [Required(ErrorMessage = "مدينة الانطلاق مطلوبة")]
        public string DepartureFrom { get; set; } = "";

        [Required(ErrorMessage = "مدينة الوصول مطلوبة")]
        public string ArrivalTo { get; set; } = "";

        [Required(ErrorMessage = "عدد المقاعد مطلوب")]
        [Range(1, 1000, ErrorMessage = "يجب أن يكون عدد المقاعد بين 1 و 1000")]
        public int TotalSeats { get; set; }

        public string Program { get; set; } = "";
    }
}