@page "/addagency"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using AgenceBlazor.Models
@using AgenceBlazor.Services
@inject AgencyService AgencyService
@inject NavigationManager Navigation

<div class="add-agency-container">
    <div class="page-header">
        <div class="header-content">
            <div class="header-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <line x1="19" y1="8" x2="19" y2="14"></line>
                    <line x1="22" y1="11" x2="16" y2="11"></line>
                </svg>
            </div>
            <div>
                <h1 class="page-title">إضافة وكالة جديدة</h1>
                <p class="page-subtitle">قم بإدخال بيانات الوكالة الجديدة</p>
            </div>
        </div>
    </div>

    <div class="form-card">
        <div class="form-body">
            <EditForm Model="@newAgency" OnValidSubmit="@HandleValidSubmit" class="agency-form">
                <DataAnnotationsValidator />

                <div class="form-grid">
                    <!-- اسم الوكالة -->
                    <div class="form-group full-width">
                        <label class="form-label" for="agencyName">اسم الوكالة</label>
                        <InputText id="agencyName"
                                   @bind-Value="newAgency.AgencyName"
                                   class="form-input"
                                   placeholder="أدخل اسم الوكالة" />
                        <ValidationMessage For="@(() => newAgency.AgencyName)" class="validation-message" />
                    </div>

                    <!-- المدينة -->
                    <div class="form-group">
                        <label class="form-label" for="city">المدينة</label>
                        <InputText id="city"
                                   @bind-Value="newAgency.City"
                                   class="form-input"
                                   placeholder="أدخل المدينة" />
                    </div>

                    <!-- الهاتف -->
                    <div class="form-group">
                        <label class="form-label" for="phone">الهاتف</label>
                        <InputText id="phone"
                                   @bind-Value="newAgency.Phone"
                                   class="form-input"
                                   placeholder="رقم الهاتف" />
                    </div>

                    <!-- عنوان الوكالة -->
                    <div class="form-group full-width">
                        <label class="form-label" for="address">عنوان الوكالة</label>
                        <InputText id="address"
                                   @bind-Value="newAgency.Address"
                                   class="form-input"
                                   placeholder="أدخل عنوان الوكالة" />
                    </div>

                    <!-- نوع الوكالة -->
                    <div class="form-group">
                        <label class="form-label" for="agencyType">نوع الوكالة</label>
                        <InputSelect id="agencyType"
                                     @bind-Value="newAgency.AgencyType"
                                     class="form-input form-select">
                            <option value="">اختر نوع الوكالة</option>
                            <option value="سياحة وسفر">سياحة وسفر</option>
                            <option value="حج وعمرة">حج وعمرة</option>
                            <option value="سفر عام">سفر عام</option>
                            <option value="سياحة داخلية">سياحة داخلية</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => newAgency.AgencyType)" class="validation-message" />
                    </div>

                    <!-- تاريخ العقد -->
                    <div class="form-group">
                        <label class="form-label" for="contractDate">تاريخ العقد</label>
                        <InputDate id="contractDate"
                                   @bind-Value="newAgency.ContractDate"
                                   class="form-input" />
                    </div>

                    <!-- عمولة الوكالة -->
                    <div class="form-group">
                        <label class="form-label" for="commission">عمولة الوكالة (%)</label>
                        <InputNumber id="commission"
                                     @bind-Value="newAgency.CommissionRate"
                                     class="form-input"
                                     placeholder="0"
                                     min="0"
                                     max="100" />
                    </div>

                    <!-- عدد المعتمرين -->
                    <div class="form-group">
                        <label class="form-label" for="pilgrimsCount">عدد المعتمرين</label>
                        <InputNumber id="pilgrimsCount"
                                     @bind-Value="newAgency.PilgrimsCount"
                                     class="form-input"
                                     placeholder="0"
                                     min="0" />
                    </div>

                    <!-- الديون -->
                    <div class="form-group">
                        <label class="form-label" for="debtAmount">الديون (دج)</label>
                        <InputNumber id="debtAmount"
                                     @bind-Value="newAgency.DebtAmount"
                                     class="form-input"
                                     placeholder="0"
                                     min="0" />
                    </div>

                    <!-- المبلغ المدفوع -->
                    <div class="form-group">
                        <label class="form-label" for="paidAmount">المبلغ المدفوع (دج)</label>
                        <InputNumber id="paidAmount"
                                     @bind-Value="newAgency.PaidAmount"
                                     class="form-input"
                                     placeholder="0"
                                     min="0" />
                    </div>

                    <!-- ملاحظات -->
                    <div class="form-group full-width">
                        <label class="form-label" for="notes">ملاحظات</label>
                        <InputTextArea id="notes"
                                       @bind-Value="newAgency.Notes"
                                       class="form-input"
                                       placeholder="ملاحظات إضافية (اختياري)" />
                    </div>
                </div>

                <div class="form-actions">
                    <span class="action-hint">تأكد من صحة البيانات قبل الإضافة</span>
                    <div class="buttons-group">
                        <button type="button" class="btn-cancel" @onclick="ResetForm" disabled="@isSaving">إلغاء</button>
                        <button type="submit" class="btn-submit" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner"></span>
                                <span>جاري الحفظ...</span>
                            }
                            else
                            {
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M12 5v14"></path>
                                    <path d="M5 12h14"></path>
                                </svg>
                                <span>إضافة الوكالة</span>
                            }
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>

    @if (showSuccessMessage)
    {
        <div class="success-overlay" @onclick="GoToAgencies">
            <div class="success-card" @onclick:stopPropagation="true">
                <div class="success-icon">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                </div>
                <h3 class="success-title">تمت الإضافة بنجاح</h3>
                <p class="success-text">تم إضافة الوكالة "@lastAddedAgencyName" بنجاح</p>
                <button class="btn-close" @onclick="GoToAgencies">عرض الوكالات</button>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-overlay">
            <div class="error-card">
                <div class="error-icon">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="15" y1="9" x2="9" y2="15"></line>
                        <line x1="9" y1="9" x2="15" y2="15"></line>
                    </svg>
                </div>
                <h3 class="error-title">خطأ</h3>
                <p class="error-text">@errorMessage</p>
                <button class="btn-close" @onclick='() => errorMessage = ""'>حسناً</button>
            </div>
        </div>
    }
</div>

@code {
    private AgencyModel newAgency = new AgencyModel
    {
        ContractDate = DateTime.Today,
        CommissionRate = 10
    };

    private bool showSuccessMessage = false;
    private string lastAddedAgencyName = "";
    private bool isSaving = false;
    private string errorMessage = "";

    private async Task HandleValidSubmit()
    {
        isSaving = true;
        
        try
        {
            var agency = new Agency
            {
                AgencyName = newAgency.AgencyName,
                AgencyType = newAgency.AgencyType,
                Address = newAgency.Address,
                City = newAgency.City,
                Phone = newAgency.Phone,
                ContractDate = newAgency.ContractDate,
                CommissionRate = newAgency.CommissionRate,
                PilgrimsCount = newAgency.PilgrimsCount,
                DebtAmount = newAgency.DebtAmount,
                PaidAmount = newAgency.PaidAmount,
                Notes = newAgency.Notes,
                Status = "Active",
                CreatedAt = DateTime.UtcNow,
                UpdatedAt = DateTime.UtcNow
            };

            var success = await AgencyService.CreateAgencyAsync(agency);

            if (success)
            {
                lastAddedAgencyName = newAgency.AgencyName;
                showSuccessMessage = true;
                ResetForm();
            }
            else
            {
                errorMessage = "فشل في إضافة الوكالة. الرجاء المحاولة مرة أخرى.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"حدث خطأ: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ResetForm()
    {
        newAgency = new AgencyModel
        {
            ContractDate = DateTime.Today,
            CommissionRate = 10
        };
    }

    private class AgencyModel
    {
        [Required(ErrorMessage = "اسم الوكالة مطلوب")]
        public string AgencyName { get; set; } = "";

        [Required(ErrorMessage = "نوع الوكالة مطلوب")]
        public string AgencyType { get; set; } = "";

        public string Address { get; set; } = "";
        public string City { get; set; } = "";
        public string Phone { get; set; } = "";
        public DateTime? ContractDate { get; set; }

        [Range(0, 100, ErrorMessage = "العمولة بين 0 و 100")]
        public decimal CommissionRate { get; set; }

        public int PilgrimsCount { get; set; }
        public decimal DebtAmount { get; set; }
        public decimal PaidAmount { get; set; }
        public string Notes { get; set; } = "";
    }

    private void GoToAgencies()
    {
        showSuccessMessage = false;
        Navigation.NavigateTo("/agencies");
    }
}