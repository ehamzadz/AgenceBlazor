    //     var w = filteredTransactions.Where(t => t.Type == "withdrawal").Sum(t => t.Amount);
    //     depositsTotal = filteredTransactions.Where(t => t.Type == "deposit" || t.Type == "transfer_from_owner").Sum(t => t.Amount);
    //     var w = filteredTransactions.Where(t => t.Type == "withdrawal" || t.Type == "transfer_to_owner").Sum(t => t.Amount);
    //     var e = filteredTransactions.Where(t => t.Type == "expense").Sum(t => t.Amount);
    //     withdrawalsTotal = w + e;
    //     expensesTotal = e;
    //     balance = depositsTotal - withdrawalsTotal;

    //     StateHasChanged();
    // }
    private decimal transferFromOwnerTotal = 0;
    private decimal transferToOwnerTotal = 0;

    private void ApplyFilters()
    {
        var query = transactions.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(searchQuery))
            query = query.Where(t => (t.Description?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) || (t.Notes?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false));
        if (!string.IsNullOrWhiteSpace(filterType))
            query = query.Where(t => t.Type == filterType);
        if (filterDateFrom.HasValue)
            query = query.Where(t => t.TransactionDate >= filterDateFrom.Value);
        if (filterDateTo.HasValue)
            query = query.Where(t => t.TransactionDate <= filterDateTo.Value);

        filteredTransactions = query.OrderByDescending(t => t.TransactionDate).ToList();

        // Update stats from filtered data
        depositsTotal = filteredTransactions.Where(t => t.Type == "deposit" || t.Type == "transfer_from_owner").Sum(t => t.Amount);
        var w = filteredTransactions.Where(t => t.Type == "withdrawal" || t.Type == "transfer_to_owner").Sum(t => t.Amount);
        var e = filteredTransactions.Where(t => t.Type == "expense").Sum(t => t.Amount);
        withdrawalsTotal = w + e;
        expensesTotal = e;
        balance = depositsTotal - withdrawalsTotal;

        // NEW: Transfer totals
        transferFromOwnerTotal = filteredTransactions.Where(t => t.Type == "transfer_from_owner").Sum(t => t.Amount);
        transferToOwnerTotal = filteredTransactions.Where(t => t.Type == "transfer_to_owner").Sum(t => t.Amount);

        StateHasChanged();
    }

    private void ClearFilters() { _searchQuery = ""; _filterType = ""; _filterDateFrom = null; _filterDateTo = null; ApplyFilters(); }

    private void OpenAddModal(string type)
    {
        formType = type;
        formModel = new TreasuryTransaction
        {
            Type = type,
            TransactionDate = DateTime.UtcNow  // Changed from DateTime.Now
        };
        showModal = true;
    }
    // private void OpenAddModal(string type) { formType = type; formModel = new TreasuryTransaction { Type = type, TransactionDate = DateTime.Now }; showModal = true; }
    private void CloseModal() { showModal = false; }
    private async Task SaveTransaction() { formModel.Type = formType; await TreasuryService.CreateAsync(formModel); showModal = false; await LoadData(); }
    private void ConfirmDelete(TreasuryTransaction t) { transactionToDelete = t; showDeleteDialog = true; }
    private void CancelDelete() { showDeleteDialog = false; transactionToDelete = null; }
    private async Task DeleteTransaction() { if (transactionToDelete == null) return; await TreasuryService.DeleteAsync(transactionToDelete.Id); showDeleteDialog = false; transactionToDelete = null; await LoadData(); }


    // Add these new variables
    private bool showTransferToOwnerModal = false;
    private string transferToOwnerSource = "bank";
    private decimal transferToOwnerAmount;
    private string transferToOwnerDescription = "";
    private DateTime transferToOwnerDate = DateTime.UtcNow;
    private string transferToOwnerNotes = "";

    // Add these methods
    private void OpenTransferToOwnerModal()
    {
        transferToOwnerAmount = 0;
        transferToOwnerDescription = "";
        transferToOwnerDate = DateTime.UtcNow;
        transferToOwnerNotes = "";
        showTransferToOwnerModal = true;
    }

    private void CloseTransferToOwnerModal() => showTransferToOwnerModal = false;

    private async Task ExecuteTransferToOwner()
    {
        bool success;
        if (transferToOwnerSource == "bank")
            success = await TreasuryService.TransferFromMainToOwnerBank(
                transferToOwnerAmount, transferToOwnerDescription, transferToOwnerDate, transferToOwnerNotes);
        else
            success = await TreasuryService.TransferFromMainToOwnerCash(
                transferToOwnerAmount, transferToOwnerDescription, transferToOwnerDate, transferToOwnerNotes);

        if (success)
        {
            showTransferToOwnerModal = false;
            await LoadData();
        }
    }



}