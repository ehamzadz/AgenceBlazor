@page "/"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<div class="home-page">
    <!-- Header -->
    <div class="home-header">
        <div>
            <h1>لوحة التحكم</h1>
            <p>مرحباً بك، إليك نظرة عامة على النظام</p>
        </div>
        <div class="header-date">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                <line x1="16" y1="2" x2="16" y2="6" />
                <line x1="8" y1="2" x2="8" y2="6" />
                <line x1="3" y1="10" x2="21" y2="10" />
            </svg>
            <span>@DateTime.Now.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("ar-SA"))</span>
        </div>
    </div>

    <!-- Stats Cards with Real Data -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon" style="background: #e8f5e9;">
                <svg viewBox="0 0 24 24" fill="none" stroke="#2e7d32" stroke-width="2">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                    <polyline points="22 4 12 14.01 9 11.01" />
                </svg>
            </div>
            <div class="stat-info">
                <span class="stat-value">@activeTrips</span>
                <span class="stat-label">الرحلات النشطة</span>
                <span class="stat-change positive">↑ @tripsChange%</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon" style="background: #e3f2fd;">
                <svg viewBox="0 0 24 24" fill="none" stroke="#1565c0" stroke-width="2">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                    <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
            </div>
            <div class="stat-info">
                <span class="stat-value">@totalTravelers.ToString("N0")</span>
                <span class="stat-label">إجمالي المسافرين</span>
                <span class="stat-change positive">↑ @travelersChange%</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon" style="background: #fff3e0;">
                <svg viewBox="0 0 24 24" fill="none" stroke="#e65100" stroke-width="2">
                    <rect x="2" y="7" width="20" height="14" rx="2" ry="2" />
                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
                </svg>
            </div>
            <div class="stat-info">
                <span class="stat-value">@totalAgencies</span>
                <span class="stat-label">الوكالات النشطة</span>
                <span class="stat-change neutral">● مستقر</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon" style="background: #fce4ec;">
                <svg viewBox="0 0 24 24" fill="none" stroke="#c62828" stroke-width="2">
                    <line x1="12" y1="1" x2="12" y2="23" />
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                </svg>
            </div>
            <div class="stat-info">
                <span class="stat-value">@totalRevenue.ToString("C0", new System.Globalization.CultureInfo("ar-SA"))</span>
                <span class="stat-label">الإيرادات الشهرية</span>
                <span class="stat-change positive">↑ @revenueChange%</span>
            </div>
        </div>
    </div>

    <!-- Recent Activity -->
    <div class="section-title">
        <h2>النشاطات الأخيرة</h2>
        <p>آخر التحديثات والإجراءات</p>
    </div>

    <div class="activity-list">
        @foreach (var activity in recentActivities)
        {
            <div class="activity-item">
                <div class="activity-icon" style="background: @activity.Color">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        @switch (activity.Type)
                        {
                            case "trip":
                                <path d="M12 2L2 7l10 5 10-5-10-5z" />
                                break;
                            case "traveler":
                                <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                                <circle cx="9" cy="7" r="4" />
                                break;
                            case "payment":
                                <line x1="12" y1="1" x2="12" y2="23" />
                                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                                break;
                            case "agency":
                                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                                break;
                        }
                    </svg>
                </div>
                <div class="activity-content">
                    <span class="activity-text">@activity.Description</span>
                    <span class="activity-time">@activity.TimeAgo</span>
                </div>
            </div>
        }
    </div>

    <!-- Quick Actions -->
    <div class="section-title">
        <h2>إجراءات سريعة</h2>
        <p>الوصول السريع إلى المهام الشائعة</p>
    </div>

    <div class="actions-grid">
        <div class="action-card" @onclick="GoToTrips">
            <div class="action-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M12 2L2 7l10 5 10-5-10-5z" />
                    <path d="M2 17l10 5 10-5" />
                    <path d="M2 12l10 5 10-5" />
                </svg>
            </div>
            <h3>إدارة الرحلات</h3>
            <p>إضافة وتعديل وإدارة جميع الرحلات</p>
            <span class="action-arrow">→</span>
        </div>

        <div class="action-card" @onclick="GoToAgencies">
            <div class="action-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                    <polyline points="9 22 9 12 15 12 15 22" />
                </svg>
            </div>
            <h3>الوكالات</h3>
            <p>إدارة الوكالات والشركاء</p>
            <span class="action-arrow">→</span>
        </div>

        <div class="action-card" @onclick="GoToTravelers">
            <div class="action-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                    <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
            </div>
            <h3>المسافرين</h3>
            <p>عرض وإدارة بيانات المسافرين</p>
            <span class="action-arrow">→</span>
        </div>

        <div class="action-card" @onclick="GoToReports">
            <div class="action-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                    <line x1="16" y1="13" x2="8" y2="13" />
                    <line x1="16" y1="17" x2="8" y2="17" />
                    <polyline points="10 9 9 9 8 9" />
                </svg>
            </div>
            <h3>التقارير</h3>
            <p>تقارير مالية وإحصائية مفصلة</p>
            <span class="action-arrow">→</span>
        </div>

        <div class="action-card" @onclick="GoToSettings">
            <div class="action-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="12" cy="12" r="3" />
                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" />
                </svg>
            </div>
            <h3>الإعدادات</h3>
            <p>تخصيص النظام وإدارة الحساب</p>
            <span class="action-arrow">→</span>
        </div>

        <div class="action-card" @onclick="HandleLogout">
            <div class="action-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
            </div>
            <h3>تسجيل الخروج</h3>
            <p>الخروج من حسابك الحالي</p>
            <span class="action-arrow">→</span>
        </div>
    </div>
</div>

@code {
    // Stats Data - Replace with actual API calls
    private int activeTrips = 24;
    private int totalTravelers = 1248;
    private int totalAgencies = 8;
    private decimal totalRevenue = 45200;

    // Percentage Changes
    private double tripsChange = 12.5;
    private double travelersChange = 8.3;
    private double revenueChange = 15.7;

    // Recent Activities
    private List<Activity> recentActivities = new()
    {
        new Activity
        {
            Type = "trip",
            Description = "تم إضافة رحلة جديدة إلى مكة المكرمة - فندق 5 نجوم",
            TimeAgo = "منذ 5 دقائق",
            Color = "#e8f5e9"
        },
        new Activity
        {
            Type = "traveler",
            Description = "تم تسجيل 12 مسافر جديد في رحلة العمرة - المجموعة الثالثة",
            TimeAgo = "منذ 15 دقيقة",
            Color = "#e3f2fd"
        },
        new Activity
        {
            Type = "payment",
            Description = "تم استلام دفعة بقيمة 15,000 ريال من وكالة الصفوة",
            TimeAgo = "منذ ساعة واحدة",
            Color = "#fce4ec"
        },
        new Activity
        {
            Type = "agency",
            Description = "تم تفعيل وكالة جديدة: وكالة الأنوار للسفر",
            TimeAgo = "منذ ساعتين",
            Color = "#fff3e0"
        },
        new Activity
        {
            Type = "trip",
            Description = "اكتمال رحلة المدينة المنورة - 45 مسافر",
            TimeAgo = "منذ 3 ساعات",
            Color = "#e8f5e9"
        },
        new Activity
        {
            Type = "payment",
            Description = "تم إصدار فاتورة جديدة للوكالة الماسية - 8,500 ريال",
            TimeAgo = "منذ 4 ساعات",
            Color = "#fce4ec"
        }
    };

    // Navigation Methods
    private void GoToTrips() => Navigation.NavigateTo("/trips");
    private void GoToAgencies() => Navigation.NavigateTo("/agencies");
    private void GoToTravelers() => Navigation.NavigateTo("/travelers");
    private void GoToReports() => Navigation.NavigateTo("/reports");
    private void GoToSettings() => Navigation.NavigateTo("/settings");

    private void HandleLogout()
    {
        Navigation.NavigateTo("/login");
    }

    // Activity Model
    private class Activity
    {
        public string Type { get; set; } = "";
        public string Description { get; set; } = "";
        public string TimeAgo { get; set; } = "";
        public string Color { get; set; } = "";
    }
}