    <script>
        window.printReceipt = function(html) {
        var win = window.open('', '_blank', 'width=450,height=600');
        win.document.write(html);
        win.document.close();
        };
        window.printReceiptText = function(html) {
        var win = window.open('', '_blank', 'width=500,height=600');
        win.document.write(html);
        win.document.close();
        win.focus();
        };
    </script>
